---
// The Details page: everything a guest needs, in the order they need it.
// Each part has a line drawing (Scene.astro) that moves as the guest scrolls.
//   variant "a": a wide drawing above each part. Its ground line is the rule.
//   variant "b": a road under the header with a car that drives to the part
//                you read, and a small drawing beside each part.
import Arrow from '../Arrow.astro';
import Faq from '../Faq.astro';
import Milestones from '../Milestones.astro';
import Scene from './Scene.astro';
import { schedule, travel, wedding, registry } from '../../data/wedding';

interface Props { variant?: 'a' | 'b'; }
const { variant = 'a' } = Astro.props;
const B = variant === 'b';

// The parts, in the order a guest needs them. The ids of the old page
// (#schedule, #travel, #registry, #faq) are the same, so old links work.
const parts = [
  { id: 'reply', scene: 'reply', title: 'Reply', lead: 'First, tell us if you can come.' },
  { id: 'travel', scene: 'fly', title: 'Get here', lead: 'Fly in, drive up, arrive.' },
  { id: 'stay', scene: 'stay', title: 'Stay', lead: 'Where to sleep, and what to do near there.' },
  { id: 'schedule', scene: 'days', title: 'The days', lead: 'The plan for the weekend.' },
  { id: 'faq', scene: 'know', title: 'Good to know', lead: 'Answers to common questions.' },
  { id: 'registry', scene: 'gifts', title: 'Gifts', lead: 'Only if you want to.' },
  { id: 'milestones', scene: '', title: 'Milestones', lead: 'How we got here.' },
] as const;
const num = (i: number) => String(i + 1).padStart(2, '0');
const [weekday, ...rest] = wedding.date.split(', ');
const deadline = wedding.rsvpDeadline.replace(/^\w+, /, '');

// A small drawing for each event, selected by words in its name.
const eventIcons: [RegExp, string][] = [
  [/welcome|drinks/i, `<path d="M9 8h8l-1 8a3 3 0 0 1-6 0zM13 19v6M9.5 25h7M19 10l7-2 1 8a3 3 0 0 1-6 1zM24.5 19l1 6M22 26l7-1"/><path d="M17 5l1-2M20 6l2-2" class="soft"/>`],
  [/ceremony/i, `<circle cx="12.5" cy="19" r="7"/><circle cx="20.5" cy="19" r="7"/><path class="fill" d="M9.5 9h6l-3 4z"/>`],
  [/cocktail/i, `<path class="fill" d="M7 8h18l-9 10z"/><path d="M16 18v8M11 26h10M20 5l-5 9"/><circle class="dot" cx="15" cy="13" r="1.4"/>`],
  [/last|send|farewell/i, `<path class="fill" d="M19 6a10 10 0 1 0 8 14 8 8 0 0 1-8-14z"/><path d="M8 6v4M6 8h4M27 5v3M25.500 6.500h3"/>`],
  [/dinner|danc/i, `<circle cx="16" cy="17" r="8"/><circle cx="16" cy="17" r="4" class="fill"/><path d="M4 8v7q0 2 1.500 2v9M2 8v5M7 8v5M28 8q-3 4-2 9h2v9"/>`],
];
const iconFor = (name: string) =>
  eventIcons.find(([re]) => re.test(name))?.[1] ?? `<circle cx="16" cy="16" r="3" class="fill"/>`;

const stepIcons = {
  fly: `<path class="fill" d="M5 17q0-3 4-3h13q6 0 9 3-3 3-9 3H9q-4 0-4-3z"/><path d="M8 14l-4-7h4l6 7M17 18l-6 9h4l10-9"/>`,
  drive: `<path d="M8 23H5q-2 0-2-2v-2q0-4 5-5c5-2 8-7 16-7 6 0 9 3 12 7l9 2q5 1 5 5v1q0 1-2 1h-3M17 23h18"/><circle cx="12.500" cy="23" r="4.500"/><circle cx="39.500" cy="23" r="4.500"/>`,
  arrive: `<path class="fill" d="M16 29c-7-8-9-12-9-16a9 9 0 0 1 18 0c0 4-2 8-9 16z"/><circle cx="16" cy="13" r="3"/>`,
};
---

{B && (
  <nav class="route" aria-label="On this page">
    <div class="route-inner">
      <p class="now label" aria-hidden="true"><span class="now-n"></span><span class="now-t">Start</span></p>
      <ol>
        {parts.map((p, i) => (
          <li><a class="stop" href={`#${p.id}`} data-stop={p.id}><span class="n">{num(i)}</span><span class="t">{p.title}</span></a></li>
        ))}
      </ol>
      <span class="road" aria-hidden="true">
        <span class="car">
          <svg viewBox="0 0 48 30"><g set:html={stepIcons.drive} /></svg>
        </span>
      </span>
    </div>
  </nav>
)}

<slot />

<div class:list={['wide', 'guide', `v-${variant}`]}>
  <header class="intro-head">
    <p class="eyebrow">The details</p>
    <h1>The weekend</h1>
    <dl class="specs">
      <div><dt class="label">Date</dt><dd>{rest.join(', ')}<br /><span class="muted">{weekday}</span></dd></div>
      <div><dt class="label">Place</dt><dd>{wedding.venue.name}<br /><span class="muted">{wedding.city}</span></dd></div>
      <div class="rsvp"><dt class="label">RSVP</dt><dd>By {deadline}<br /><a href="/wedding/rsvp">Reply now</a></dd></div>
    </dl>
    <p class="how muted">Scroll down. Sapporo shows you each part, in the order that you need it.</p>
  </header>

  {!B && (
    <Fragment>
      <div class="banner first"><Scene name="road" /></div>
      <nav class="contents" aria-label="On this page">
        {parts.map((p, i) => (
          <a class="toc" href={`#${p.id}`}><span class="label">{num(i)}</span><span class="t">{p.title}</span></a>
        ))}
      </nav>
    </Fragment>
  )}

  {parts.map((p, i) => (
    <section class:list={['part', { story: p.id === 'milestones' }]} id={p.id} data-part aria-labelledby={`${p.id}-title`}>
      {!B && p.scene && <div class="banner"><Scene name={p.scene} /></div>}
      <header class:list={['part-head', 'reveal', { ruled: B || !p.scene }]}>
        <p class="label">§ {num(i)}</p>
        <h2 id={`${p.id}-title`}>{p.title}</h2>
        <p class="lead">{p.lead}</p>
        {B && p.scene && <div class="spot-wrap"><Scene name={p.scene} spot /></div>}
      </header>

      {p.id === 'reply' && (
        <div class="part-body">
          <p class="statement reveal">Please reply by {deadline}.</p>
          <p class="reveal note">It takes about one minute. You need the last name on your invitation.</p>
          <p class="reveal"><a class="button" href="/wedding/rsvp">RSVP <Arrow /></a></p>
        </div>
      )}

      {p.id === 'travel' && (
        <div class="part-body">
          <ol class="steps">
            <li class="step reveal">
              <svg class="ico" viewBox="0 0 36 32" aria-hidden="true" set:html={stepIcons.fly} />
              <h3 class="label"><span class="k">1</span> Fly in</h3>
              {travel.airports.map((a) => (
                <p><strong>{a.name}</strong><br /><span class="muted">{a.note}</span></p>
              ))}
            </li>
            <li class="step reveal" style="--delay: 0.08s">
              <svg class="ico" viewBox="0 0 52 32" aria-hidden="true" set:html={stepIcons.drive} />
              <h3 class="label"><span class="k">2</span> Drive up</h3>
              <p>{travel.gettingAround}</p>
            </li>
            <li class="step reveal" style="--delay: 0.16s">
              <svg class="ico" viewBox="0 0 32 32" aria-hidden="true" set:html={stepIcons.arrive} />
              <h3 class="label"><span class="k">3</span> Arrive</h3>
              <p><strong>{wedding.venue.name}</strong><br /><span class="muted">{wedding.venue.address}</span></p>
            </li>
          </ol>
          {wedding.venue.mapUrl && (
            <p class="reveal map"><a class="button" href={wedding.venue.mapUrl} target="_blank" rel="noopener">Open the map <Arrow /></a></p>
          )}
        </div>
      )}

      {p.id === 'stay' && (
        <div class="part-body">
          <div class="hotels">
            {travel.hotels.map((h) => (
              <div class="hotel reveal">
                <p class="hotel-name">{h.url ? <a href={h.url} target="_blank" rel="noopener">{h.name}</a> : h.name}</p>
                <p class="muted">{h.address}</p>
                <p>{h.note}</p>
              </div>
            ))}
          </div>
          <div class="todo reveal">
            <h3 class="label">While you are here</h3>
            <ul>{travel.thingsToDo.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
      )}

      {p.id === 'schedule' && (
        <div class="part-body">
          {schedule.map((day) => (
            <div class="day">
              <h3 class="label day-name">{day.day}</h3>
              <ol class="events">
                {day.events.map((event) => (
                  <li class="event reveal">
                    <svg class="ico" viewBox="0 0 32 32" aria-hidden="true" set:html={iconFor(event.name)} />
                    <p class="time">{event.time}</p>
                    <div>
                      <h4>{event.name}</h4>
                      {event.place && <p class="muted">{event.place}</p>}
                      {event.details && <p class="small">{event.details}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      )}

      {p.id === 'faq' && <div class="part-body"><Faq /></div>}

      {p.id === 'registry' && (
        <div class="part-body">
          <p class="statement reveal">{registry.intro}</p>
          <div class="stores reveal">
            {registry.links.map((r) =>
              r.url ? (
                <a class="button" href={r.url} target="_blank" rel="noopener">{r.name} <Arrow /></a>
              ) : (
                <span class="store">{r.name}</span>
              ),
            )}
          </div>
        </div>
      )}

      {p.id === 'milestones' && <Milestones />}
    </section>
  ))}

  <aside class="end reveal">
    <p class="end-title">See you on {rest.join(', ').replace(/, \d{4}$/, '')}.</p>
    <a class="button" href="/wedding/rsvp">RSVP <Arrow /></a>
  </aside>
</div>

<style>
  :global(html) { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }

  /* ---------- Top ---------- */
  .intro-head { padding: clamp(16px, 4vw, 48px) 0 clamp(28px, 4vw, 44px); }
  .intro-head .eyebrow { color: var(--accent); margin: 0 0 12px; }
  .intro-head h1 {
    font-size: clamp(3.4rem, 11vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 clamp(28px, 4vw, 48px);
  }
  .specs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--text); margin: 0; max-width: 820px; }
  .specs > div { padding: 14px 16px 0 0; }
  .specs > div + div { border-left: 1px solid var(--line); padding-left: 16px; }
  .specs dt { margin: 0 0 6px; }
  .specs dd { margin: 0; line-height: 1.4; }
  @media (max-width: 560px) {
    .specs { grid-template-columns: 1fr 1fr; }
    .specs > div + div.rsvp { grid-column: 1 / -1; border-left: 0; padding-left: 0; border-top: 1px solid var(--line); margin-top: 14px; }
  }
  .how { margin: 28px 0 0; font-size: 0.95rem; }

  /* ---------- Drawings ---------- */
  /* Version A: a wide drawing above each part. On a phone it goes edge to edge. */
  .banner { grid-column: 1 / -1; height: clamp(180px, 24vw, 300px); margin: 0 calc(-1 * var(--gutter)); }
  @media (min-width: 720px) { .banner { margin: 0; } }
  .banner :global(.scene) { height: 100%; }
  .banner.first { height: clamp(160px, 20vw, 250px); }
  /* Version B: a small drawing below the heading of each part. */
  .spot-wrap { margin-top: 18px; aspect-ratio: 5 / 3; max-width: 400px; }
  .spot-wrap :global(.scene) { height: 100%; }

  /* A table of contents: all parts are on one page, so these only scroll. */
  .contents { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .contents a {
    display: flex; align-items: baseline; gap: 10px; padding: 14px 12px 14px 0;
    border-bottom: 1px solid var(--line); text-decoration: none; color: var(--text);
  }
  .contents .t { font-family: var(--display); font-size: 1.35rem; transition: color 0.3s var(--ease); }
  .contents a:is(:hover, :focus-visible) .t { color: var(--accent); }

  /* ---------- Parts: heading on the left, content on the right ---------- */
  .part { padding-top: clamp(56px, 8vw, 104px); scroll-margin-top: 48px; display: grid; gap: 0 48px; }
  .part-head { padding-top: 18px; margin-bottom: 28px; display: grid; gap: 6px; align-content: start; }
  .part-head h2 { margin: 0; }
  .part-head .label, .part-head .lead { margin: 0; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 26ch; }
  @media (min-width: 900px) {
    .part:not(.story) { grid-template-columns: 4fr 8fr; }
    .part:not(.story) .part-head { position: sticky; top: 88px; align-self: start; }
    .part-body { padding-top: 18px; }
  }
  .v-b .part { scroll-margin-top: 104px; }
  @media (min-width: 900px) { .v-b .part:not(.story) .part-head { top: 132px; } }

  .statement { font-family: var(--display); font-size: clamp(1.7rem, 3.4vw, 2.4rem); line-height: 1.2; letter-spacing: -0.01em; margin: 0 0 16px; max-width: 24ch; }
  .note { margin: 0 0 24px; color: var(--muted); max-width: 44ch; }

  /* Small drawings inside the content. */
  .ico { display: block; height: 34px; width: auto; fill: none; stroke: var(--accent); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; overflow: visible; }
  .ico :global(.fill) { fill: color-mix(in srgb, var(--accent) 18%, transparent); }
  .ico :global(.dot) { fill: var(--accent); stroke: none; }
  .ico :global(.soft) { stroke: var(--muted); }

  /* Get here: three steps in a row. */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0 28px; border-top: 1px solid var(--line); }
  .step { padding: 24px 0; border-bottom: 1px solid var(--line); }
  .step .ico { margin-bottom: 16px; }
  .step h3 { margin: 0 0 10px; }
  .step .k { color: var(--accent); margin-right: 6px; }
  .step p { margin: 0; }
  .map { margin: 28px 0 0; }

  /* Stay */
  .hotels { border-top: 1px solid var(--line); }
  .hotel { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .hotel p { margin: 0; }
  .hotel-name { font-family: var(--display); font-size: 1.6rem; line-height: 1.15; margin: 0 0 4px; }
  .todo { padding-top: 24px; }
  .todo h3 { margin: 0 0 10px; }
  .todo ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px 28px; }
  .todo li::before { content: '— '; color: var(--accent); }

  /* The days */
  .day + .day { margin-top: 40px; }
  .day-name { margin: 0 0 4px; color: var(--accent); }
  .events { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .event { display: grid; grid-template-columns: 44px 100px 1fr; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .event .ico { height: 36px; margin-top: 2px; }
  .event h4 { margin: 0 0 2px; font-family: var(--display); font-weight: 400; font-size: 1.6rem; line-height: 1.15; }
  .event p { margin: 0; }
  .event .small { margin-top: 6px; }
  .time { font-size: 0.95rem; letter-spacing: 0.04em; color: var(--accent); padding-top: 8px; font-variant-numeric: tabular-nums; }
  @media (max-width: 520px) {
    .event { grid-template-columns: 44px 1fr; gap: 2px 14px; }
    .event .ico { grid-row: 1 / span 2; }
    .time { padding-top: 0; }
  }

  /* Gifts */
  .stores { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 12px; }
  .store { border: 1px solid var(--line); padding: 12px 18px; color: var(--muted); }

  /* The end */
  .end {
    margin: clamp(72px, 10vw, 140px) 0 clamp(24px, 4vw, 48px);
    border-top: 1px solid var(--text);
    padding-top: 28px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px;
  }
  .end-title { font-family: var(--display); font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1; margin: 0; }

  /* ---------- Version B: the road under the header ---------- */
  .route {
    position: sticky; top: var(--header-h, 57px); z-index: 9;
    background: var(--bg);
    margin-top: -48px; /* main has 48px of padding at the top */
    margin-bottom: 24px;
  }
  .route-inner { max-width: var(--wide); margin: 0 auto; padding: 8px var(--gutter) 0; position: relative; }
  .route ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .stop { display: block; padding: 4px 0 24px; text-decoration: none; color: var(--muted); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 500; text-align: center; transition: color 0.3s var(--ease); position: relative; }
  .stop .n { display: none; }
  .stop:is(:hover, :focus-visible), .stop.on { color: var(--text); }
  /* A tick on the road for each stop. */
  .stop::after { content: ''; position: absolute; left: 50%; bottom: 0; width: 1px; height: 6px; background: var(--muted); }
  /* The road is the bottom edge. The car drives along it, and slows to a stop. */
  .road { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 0; height: 1px; background: var(--text); pointer-events: none; }
  .car { position: absolute; left: 0; bottom: 0; width: 44px; height: 27px; margin-left: -22px; transform: translateX(var(--cx, 22px)); transition: transform 0.9s var(--glide); }
  .car svg { display: block; width: 100%; height: 100%; overflow: visible; fill: var(--bg); stroke: var(--accent); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; transform: translateY(1.500px); }
  .now { display: none; margin: 0 0 2px; color: var(--text); }
  .now-n { color: var(--accent); }
  @media (max-width: 760px) {
    .now { display: block; }
    .stop { padding: 0 0 26px; }
    .stop .t { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  }
  @media (prefers-reduced-motion: reduce) { .car { transition: none; } }
</style>

<script>
  // 1. Each drawing gets --p: 0 when it comes in at the bottom of the screen,
  //    1 when it goes out at the top. A small sketch (version B) stays in view
  //    while its part scrolls, so it uses the position of the full part.
  // 2. Version B: the car drives to the stop of the part that you read.
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scenes = [...document.querySelectorAll<HTMLElement>('.scene')].map((el) => ({
    el,
    box: el.classList.contains('spot') ? el.closest<HTMLElement>('[data-part]') ?? el : el,
  }));
  const parts = [...document.querySelectorAll<HTMLElement>('[data-part]')];
  const route = document.querySelector<HTMLElement>('.route');
  const stops = route ? [...route.querySelectorAll<HTMLAnchorElement>('.stop')] : [];
  const car = route?.querySelector<HTMLElement>('.car');
  const nowN = route?.querySelector<HTMLElement>('.now-n');
  const nowT = route?.querySelector<HTMLElement>('.now-t');
  const header = document.querySelector<HTMLElement>('.site-header');
  let current = -2;

  const drive = (i: number) => {
    if (!route || !car) return;
    stops.forEach((s, k) => s.classList.toggle('on', k === i));
    const s = stops[i];
    const road = car.parentElement!;
    const x = s ? s.getBoundingClientRect().left + s.offsetWidth / 2 - road.getBoundingClientRect().left : 22;
    car.style.setProperty('--cx', `${x.toFixed(1)}px`);
    if (nowN) nowN.textContent = s ? `${s.querySelector('.n')!.textContent} ` : '';
    if (nowT) nowT.textContent = s ? s.querySelector('.t')!.textContent : 'Start';
  };

  let queued = false;
  const update = () => {
    queued = false;
    const vh = window.innerHeight;
    for (const { el, box } of scenes) {
      const r = box.getBoundingClientRect();
      const live = r.bottom > 0 && r.top < vh;
      el.classList.toggle('live', live);
      if (!live || calm) continue;
      const p = (vh - r.top) / (vh + r.height);
      el.style.setProperty('--p', Math.min(1, Math.max(0, p)).toFixed(4));
    }
    if (route) {
      let i = -1;
      parts.forEach((part, k) => { if (part.getBoundingClientRect().top < vh * 0.45) i = k; });
      if (i !== current) { current = i; drive(i); }
    }
  };
  const ask = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
  if (header && route) route.style.setProperty('--header-h', `${header.offsetHeight}px`);
  update();
  window.addEventListener('scroll', ask, { passive: true });
  window.addEventListener('resize', () => { current = -2; ask(); });
</script>
