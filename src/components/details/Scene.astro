---
// A line drawing for one part of the Details page. Each drawing is made on a
// 1200 x 240 grid. The important items are between x = 400 and x = 800, so
// that a phone (which shows the middle only) or a small "spot" shows them all.
//
// Motion: items rise from the ground line when the drawing comes into view
// (class .pop). One item in each drawing moves with the scroll position
// (class .go, driven by --p from 0 to 1; see the script in Guide.astro).
// Only transform and opacity change.
import { wedding } from '../../data/wedding';

interface Props {
  name: 'road' | 'reply' | 'fly' | 'stay' | 'days' | 'know' | 'gifts';
  /** Show the middle 400 x 240 only, as a small sketch beside the text. */
  spot?: boolean;
}
const { name, spot = false } = Astro.props;

const G = 226; // the ground line

// ---- Small helpers that draw repeated items ----
const rng = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
/** A far ridge across the full width. */
const ridge = (seed: number, base: number, amp: number) => {
  const r = rng(seed);
  const a1 = r() * 6;
  const a2 = r() * 6;
  let d = '';
  for (let x = 0; x <= 1200; x += 12) {
    const y = base - (Math.sin(x / 170 + a1) * 0.5 + 0.5) * amp - Math.sin(x / 47 + a2) * amp * 0.18 - r() * amp * 0.1;
    d += `${x ? 'L' : 'M'}${x} ${y.toFixed(1)}`;
  }
  return `<path class="soft" d="${d}"/>`;
};
/** A pine: a trunk and three tiers. */
const pine = (x: number, h: number) => {
  const w = h * 0.3;
  let d = `M${x} ${G}V${(G - h * 0.9).toFixed(1)}`;
  for (let i = 0; i < 3; i++) {
    const base = G - h * (0.16 + i * 0.25);
    const half = w * (1 - i * 0.24);
    d += `M${(x - half).toFixed(1)} ${base.toFixed(1)}L${x} ${(base - h * 0.36).toFixed(1)}L${(x + half).toFixed(1)} ${base.toFixed(1)}`;
  }
  return `<path d="${d}"/>`;
};
const pines = (...list: [number, number][]) => list.map(([x, h]) => pine(x, h)).join('');
const grass = (...xs: number[]) => `<path d="${xs.map((x) => `M${x} ${G}l-3-7M${x + 4} ${G}v-10M${x + 8} ${G}l3-6`).join('')}"/>`;
const cloud = (x: number, y: number, s = 1) =>
  `<g transform="translate(${x} ${y}) scale(${s})"><path class="paper" d="M8 22h36a8 8 0 0 0 1-16 13 13 0 0 0-24-3A9 9 0 0 0 8 10a6 6 0 0 0 0 12z"/></g>`;
const star = (x: number, y: number, r: number, d = 0) =>
  `<path class="tw fill" style="--d:${d}s" d="M${x} ${y - r}Q${x} ${y} ${x + r} ${y}Q${x} ${y} ${x} ${y + r}Q${x} ${y} ${x - r} ${y}Q${x} ${y} ${x} ${y - r}z"/>`;
const heart = (x: number, y: number, s = 1, cls = 'fill') =>
  `<g transform="translate(${x} ${y}) scale(${s})"><path class="${cls}" d="M0 4c-3-6-12-4-10 3 1 4 6 7 10 10 4-3 9-6 10-10 2-7-7-9-10-3z"/></g>`;
const flower = (x: number, h: number, lean = 2) =>
  `<path d="M${x} ${G}q${-lean} ${-h / 2} ${lean} ${-h + 5}M${x} ${G - h * 0.35}q-7-1-9-7q7 0 9 7"/><circle class="fill" cx="${x + lean}" cy="${G - h}" r="5"/><circle class="dot" cx="${x + lean}" cy="${G - h}" r="1.2"/>`;
const pop = (i: number, inner: string) => `<g class="pop" style="--i:${i}">${inner}</g>`;
const ground = `<path class="ground" d="M0 ${G + 0.5}H1200"/>`;


// Sapporo, the dog. He is in each drawing, as the guide. Three poses, drawn
// with the ground at y = 0. "flip" turns him to look left.
const place = (x: number, flip: boolean, s: number, inner: string) =>
  `<g transform="translate(${x} ${G}) scale(${flip ? -s : s} ${s})">${inner}</g>`;
const bow = (x: number, y: number) => `<path class="fill" d="M${x} ${y}l-5-4v8zM${x} ${y}l5-4v8z"/>`;
const dogSit = (x: number, flip = false, extra = '', s = 1.05) => place(x, flip, s, `
  <g class="tail"><path d="M-13-2C-21-3-23-12-18-17"/></g>
  <path class="paper" d="M-12 0C-17-12-12-27-1-33L2-37C0-45 6-52 13-51c4 0 6 2 8 4l7 2c2 1 2 4 0 5l-9 2c-1 3-3 5-6 6 1 6 1 12 0 17V0h7c1-3-2-4-5-4M-12 0H5"/>
  <path d="M5 0C6-8 2-15-6-15M9-16V0"/>
  <path class="fill" d="M5-49c-5 1-7 7-6 14 3 1 6-1 7-4 1-4 1-7-1-10z"/>
  <circle class="dot" cx="15" cy="-45" r="1"/><circle class="dot" cx="28" cy="-43" r="1.3"/>${extra}`);
const dogStand = (x: number, flip = false, extra = '', s = 1.05) => place(x, flip, s, `
  <g class="tail"><path d="M-22-27C-30-30-32-38-29-44"/></g>
  <path class="paper" d="M-22-27C-12-30 4-30 14-29L19-38C17-46 23-53 30-52c4 0 6 2 8 4l7 2c2 1 2 4 0 5l-9 2c-1 3-3 5-6 6C30-27 28-21 24-18V0h-6v-17C8-13-4-13-10-16l-3 8 2 8h-6l-2-8C-22-12-25-20-22-27z"/>
  <path d="M24 0h4M-11 0h4"/>
  <path class="fill" d="M22-49c-5 1-7 7-6 14 3 1 6-1 7-4 1-4 1-7-1-10z"/>
  <circle class="dot" cx="32" cy="-46" r="1"/><circle class="dot" cx="45" cy="-44" r="1.3"/>${extra}`);
const dogSleep = (x: number, flip = false, s = 1.05) => place(x, flip, s, `
  <path class="paper" d="M-24 0c-3-10 6-19 20-19 12 0 20 5 23 12l6 1c3 1 3 6 0 6z"/>
  <path d="M19-7c-6-1-10 2-11 7M-22-3c6-3 14-3 20 3M16-4q2 2 4 0"/>
  <path class="fill" d="M12-9c-4 0-7 3-7 8 3 1 6 0 8-3 1-2 1-4-1-5z"/>
  <circle class="dot" cx="26" cy="-3" r="1.2"/>`);
const zzz = (x: number, y: number) =>
  `<g class="zz"><path d="M${x} ${y}h6l-6 7h6"/></g><g class="zz"><path d="M${x + 11} ${y - 13}h5l-5 6h5"/></g>`;
const dogHead = `
  <g transform="translate(57 14) scale(0.8)">
    <path class="paper" d="M-8 6c-3-8 2-16 9-16 4 0 6 2 8 4l7 2c2 1 2 4 0 5l-9 2c-1 4-4 6-8 6z"/>
    <g class="ear"><path class="fill" d="M-4-8c-7-1-13 2-17 6 3 3 9 4 13 1 3-2 4-4 4-7z"/></g>
    <circle class="dot" cx="3" cy="-4" r="1"/><circle class="dot" cx="16" cy="-2" r="1.3"/>
    <path class="fill" d="M9 3c0 4 4 5 5 2"/>
  </g>`;

// "July 1" from the RSVP deadline, for the small sign in the first drawing.
const [, month = '', day = ''] = wedding.rsvpDeadline.match(/(\w+) (\d+), \d{4}$/) ?? [];

const car = `
  <g class="car">
    <path class="paper" d="M17 35H7q-4 0-4-4v-4q0-7 9-9C25 14 35 4 55 4c14 0 22 6 30 13l23 4q13 2 13 10v1q0 3-3 3h-9"/>
    <path d="M39 35h48"/>
    <path class="fill" d="M36 17c6-7 12-9 19-9 10 0 16 3 23 9z"/>
    <path d="M109 26h8M5 25h7"/>${dogHead}
    <g class="wheel"><circle class="paper" cx="28" cy="35" r="9"/><path d="M28 29v12M22 35h12"/></g>
    <g class="wheel"><circle class="paper" cx="98" cy="35" r="9"/><path d="M98 29v12M92 35h12"/></g>
    <path class="paper" d="M42 4v-12h24v12"/><path d="M50-8v-3h8v3M48-8v12M60-8v12M38 4h34"/>
  </g>`;

const art: Record<Props['name'], string> = {
  // The drive up: a car with a bag on the roof goes to the castle.
  road: `
    ${ridge(5, 150, 60)}
    ${pop(0, `<path d="M300 ${G}L372 138l34 40 46-64 78 112" class="soft"/>`)}
    ${pop(1, pines([90, 60], [124, 84], [162, 52], [1040, 70], [1084, 96], [1130, 58]))}
    ${pop(2, `<path d="M768 ${G}v-90"/><path class="paper" d="M712 100h100l14 16-14 16H712z"/>
      <text class="t" x="766" y="113">DUNAFON</text><text class="t" x="766" y="126">CASTLE</text>`)}
    ${pop(3, grass(236, 610, 944))}
    <g class="go"><g transform="translate(0 ${G - 55.5}) scale(1.25)">${car}</g></g>
    ${ground}`,

  // Reply: a letter goes to the mailbox. A sign shows the last day to reply.
  reply: `
    ${ridge(11, 168, 44)}
    ${pop(0, pines([120, 64], [158, 92], [1010, 80], [1052, 54]))}
    ${pop(1, `<path d="M566 ${G}v-74"/>
      <path class="paper" d="M534 116h58a14 14 0 0 1 14 14v22h-72z"/>
      <path class="fill" d="M520 152v-22a14 14 0 0 1 28 0v22z"/>
      <path d="M520 152h86"/><circle class="dot" cx="534" cy="134" r="1.4"/>`)}
    <g class="flag"><path class="fill" d="M590 114h14v10h-14z"/><path d="M590 142v-28"/></g>
    ${pop(2, `<path d="M690 ${G}v-36"/><path class="paper" d="M642 126h96v64h-96z"/>
      <text class="t" x="690" y="146">REPLY BY</text>
      <text class="big" x="690" y="178">${month} ${day}</text>`)}
    ${pop(3, `${grass(610, 760)}${flower(446, 34)}${flower(790, 28, -2)}${dogSit(492, true)}`)}
    <g class="go"><g transform="translate(424 106) rotate(-8)">
      <path class="paper" d="M0 0h58v38H0z"/><path d="M0 0l29 21L58 0"/>
      <path class="soft" d="M-12 10h-18M-10 22h-26M-14 33h-14"/>
      ${heart(29, 22, 0.5)}
    </g></g>
    ${ground}`,

  // Get here: a plane comes in over the mountains.
  fly: `
    ${ridge(23, 176, 40)}
    ${pop(0, `<path class="paper" d="M372 ${G}L486 120l44 50 62-80 92 96 40-30 96 70"/>
      <path d="M471 134l9 7 8-9 9 9h8M576 111l9 6 9-10 9 9 7-7"/>`)}
    ${pop(1, pines([404, 44], [432, 60], [806, 52], [838, 38], [180, 70], [216, 50], [980, 64], [1020, 88]))}
    <g class="drift">${cloud(430, 64, 1)}${cloud(716, 20, 0.8)}${cloud(150, 50, 1)}${cloud(980, 30, 1.2)}</g>
    ${pop(2, dogSit(700, true))}
    ${pop(3, `<g class="pin"><path class="paper" d="M748 172c-12-14-16-21-16-29a16 16 0 0 1 32 0c0 8-4 15-16 29z"/>${heart(748, 136, 0.55)}</g>`)}
    <g class="go"><g transform="translate(600 46) rotate(5)">
      <path class="soft dash" d="M-56 0h-110"/>
      <path class="paper" d="M-40 0q0-7 10-7h46q16 0 24 7-8 7-24 7h-46q-10 0-10-7z"/>
      <path class="paper" d="M-36-7l-9-15h9l14 15z"/>
      <path class="paper" d="M-2 3l-16 19h9l25-19z"/>
      <path d="M20-2h6M8-2h4M-2-2h4M-12-2h4"/>
    </g></g>
    ${ground}`,

  // Stay: a cabin in the pines at night.
  stay: `
    ${ridge(37, 170, 48)}
    <path class="fill" d="M716 34a24 24 0 1 0 14 40 20 20 0 0 1-14-40z"/>
    ${star(452, 40, 6, 0)}${star(520, 70, 4, 1.2)}${star(640, 30, 5, 0.6)}${star(786, 96, 4, 1.8)}${star(250, 60, 5, 0.9)}${star(930, 44, 6, 0.3)}${star(1080, 84, 4, 1.5)}${star(110, 100, 4, 2.1)}
    ${pop(0, pines([452, 118], [492, 76], [716, 92], [752, 128], [792, 66], [170, 80], [206, 56], [1000, 90], [1040, 60]))}
    ${pop(1, `<path class="paper" d="M626 152v-26h14v56"/>
      <path class="paper" d="M536 ${G}L600 92l64 134z"/>
      <path d="M552 ${G}L600 126l48 100M524 ${G}h152"/>
      <path class="fill" d="M588 ${G}v-32h24v32z"/><circle class="dot" cx="607" cy="211" r="1.3"/>
      <circle class="lamp" cx="600" cy="162" r="10"/><path d="M600 152v20M590 162h20"/>`)}
    <g class="smoke"><circle cx="633" cy="116" r="4"/><circle cx="638" cy="104" r="5.5"/><circle cx="633" cy="90" r="7"/></g>
    ${pop(3, `${grass(420, 830)}${dogSleep(672)}`)}
    ${zzz(704, 196)}
    ${ground}`,

  // The days: the castle, with the sun that moves across the sky.
  days: `
    ${ridge(51, 172, 46)}
    <g class="sun"><circle class="gold" cx="600" cy="40" r="13"/>
      <path class="goldline" d="M600 16v-7M600 64v7M576 40h-7M624 40h7M583 23l-5-5M617 57l5 5M617 23l5-5M583 57l-5 5"/></g>
    ${pop(0, `${pines([400, 60], [770, 84], [800, 58], [150, 74], [190, 50], [1010, 66], [1050, 92])}
      <circle class="paper" cx="738" cy="186" r="20"/><path d="M738 ${G}v-26M738 204l-8-8M738 198l7-7"/>`)}
    ${pop(1, `<path class="paper" d="M544 ${G}v-74h10v-8h12v8h12v-8h12v8h12v-8h12v8h12v-8h12v8h8v74z"/>
      <path class="paper" d="M500 ${G}V112h-5v-13h10v6h10v-6h10v6h10v-6h9v13h-5v114z"/>
      <path class="paper" d="M656 ${G}V108h40v118z"/><path class="fill" d="M650 108l26-42 26 42z"/>
      <path class="fill" d="M586 ${G}v-30a14 14 0 0 1 28 0v30z"/>
      <path d="M522 132v14M522 170v14M676 128v14M676 168v14M562 184v-8a5 5 0 0 1 10 0v8zM628 184v-8a5 5 0 0 1 10 0v8z"/>`)}
    ${pop(2, `<path d="M544 122q56 24 112-6"/>
      <path class="fill" d="M556 127l9 3-6 8zM576 131l9 1-5 9zM595 132h10l-5 9zM615 131l9-2-3 10zM635 125l8-3-2 10z"/>`)}
    <g class="wave"><path class="fill" d="M676 46l18 5-18 6z"/></g><path d="M676 66V44"/>
    ${pop(3, `${grass(408, 836)}${dogStand(446, false, bow(27, -27))}<path class="soft" d="M832 214h36M850 220h28M330 216h30M344 221h22"/>`)}
    ${ground}`,

  // Good to know: a trail signpost, with a bird on top.
  know: `
    ${ridge(67, 174, 42)}
    ${pop(0, pines([170, 72], [206, 50], [1000, 60], [1038, 86], [392, 58], [790, 70]))}
    ${pop(1, `<path d="M600 ${G}V84M592 84h16"/>`)}
    <g class="board b1"><path class="paper" d="M604 94h76l13 12-13 12h-76z"/><text class="t" x="646" y="110">DRESS CODE</text></g>
    <g class="board b2"><path class="paper" d="M596 126h-72l-13 12 13 12h72z"/><text class="t" x="558" y="142">PLUS ONES</text></g>
    <g class="board b1 b3"><path class="paper" d="M604 158h64l13 12-13 12h-64z"/><text class="t" x="640" y="174">PARKING</text></g>
    <g class="bird"><g transform="translate(600 84)">
      <path class="paper" d="M-11-8c1-8 11-11 17-6l8 2-7 3c0 6-5 10-11 9s-8-4-7-8z"/>
      <path d="M-10-5l-10 5M-2 0v-1M3 0v-1"/><circle class="dot" cx="5" cy="-11" r="1.1"/>
    </g></g>
    ${pop(3, `${flower(470, 40)}${flower(490, 26, -2)}${dogSit(540, false)}${flower(716, 30)}${flower(738, 44, -2)}${grass(660, 764)}
      <path class="paper" d="M416 ${G}q3-15 18-15t22 15z"/>`)}
    ${ground}`,

  // Gifts: the lid of the box lifts and hearts come out.
  gifts: `
    ${ridge(83, 176, 40)}
    ${pop(0, pines([160, 66], [198, 90], [1012, 76], [1050, 52], [424, 64], [836, 54]))}
    <g class="hearts"><g>${heart(586, 118, 0.8)}</g><g>${heart(614, 104, 0.6)}</g><g>${heart(600, 126, 0.5)}</g></g>
    ${pop(1, `<path class="paper" d="M500 ${G}v-46h42v46z"/><path d="M521 ${G}v-46M494 180h54"/>
      <path d="M521 180c-4-9-13-8-11-2s8 3 11 2c3 1 9 4 11-2s-7-7-11 2"/>`)}
    ${pop(2, `<path class="paper" d="M556 ${G}v-56h88v56z"/><path class="fill" d="M592 ${G}v-56h16v56z"/>`)}
    <g class="lid"><path class="paper" d="M548 154h104v16H548z"/><path class="fill" d="M592 154h16v16h-16z"/>
      <path class="paper" d="M600 154c-6-16-26-18-25-7 1 8 15 8 25 7zM600 154c6-16 26-18 25-7-1 8-15 8-25 7z"/><circle class="fill" cx="600" cy="153" r="3.500"/></g>
    ${pop(3, `<path class="paper" d="M664 ${G}v-34h44v34z"/><path d="M686 ${G}v-34M658 192h56"/>
      <path d="M686 192c-4-9-13-8-11-2s8 3 11 2c3 1 9 4 11-2s-7-7-11 2"/>
      ${grass(738)}${flower(790, 30, -2)}${flower(476, 26)}${dogSit(752, true, bow(11, -29))}`)}
    ${ground}`,
};
---

<div class:list={['scene', `scene-${name}`, { spot }, 'reveal']} aria-hidden="true">
  <svg viewBox={spot ? '400 0 400 240' : '0 0 1200 240'} preserveAspectRatio="xMidYMax slice" set:html={art[name]} />
</div>

<style is:global>
  .scene { --p: 0.5; position: relative; }
  .js .scene.reveal { opacity: 1; transform: none; }
  .scene svg {
    display: block; width: 100%; height: 100%; overflow: hidden;
    fill: none; stroke: var(--accent); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round;
  }
  .scene svg * { vector-effect: non-scaling-stroke; }
  .scene .fill { fill: color-mix(in srgb, var(--accent) 20%, var(--bg)); }
  .scene .paper { fill: var(--bg); }
  .scene .dot { fill: var(--accent); stroke: none; }
  .scene .soft { stroke: color-mix(in srgb, var(--muted) 45%, var(--bg)); }
  .scene .dash { stroke-dasharray: 5 7; }
  .scene .gold { fill: color-mix(in srgb, var(--gold) 24%, var(--bg)); stroke: var(--gold); }
  .scene .goldline { stroke: var(--gold); }
  .scene .lamp { fill: color-mix(in srgb, var(--gold) 30%, var(--bg)); }
  .scene text { stroke: none; text-anchor: middle; }
  .scene .t { fill: var(--muted); font: 500 10.5px var(--sans); letter-spacing: 0.12em; }
  .scene .big { fill: var(--text); font: 400 27px var(--display); }

  /* The ground line draws from left to right. It is also the rule of the part. */
  .scene .ground { stroke: var(--text); stroke-width: 1; transform-box: fill-box; transform-origin: left center; }
  .js .scene .ground { transform: scaleX(0); transition: transform 1.1s var(--machined); }
  .js .scene.in .ground { transform: none; }

  /* Items rise from the ground, one after the other. */
  .js .scene .pop {
    opacity: 0; transform: translateY(18px);
    transition: opacity 0.6s var(--ease), transform 0.9s var(--glide);
    transition-delay: calc(0.2s + var(--i, 0) * 0.1s);
  }
  .js .scene.in .pop { opacity: 1; transform: none; }

  /* Items that move with the scroll position (--p goes from 0 to 1). */
  .scene .go, .scene .drift, .scene .sun { will-change: transform; }
  .scene-road .go { transform: translateX(calc(230px + var(--p) * 480px)); }
  .scene-road .wheel { transform-box: fill-box; transform-origin: center; transform: rotate(calc(var(--p) * 2400deg)); }
  .scene-fly .go { transform: translate(calc((var(--p) - 0.5) * 760px), calc((var(--p) - 0.5) * 30px)); }
  .scene .drift { transform: translateX(calc((0.5 - var(--p)) * 90px)); }
  /* The letter arrives at the mailbox at about the time the drawing is in the middle of the screen. */
  .scene-reply .go { transform: translateX(calc((min(var(--p), 0.5) - 0.5) * 420px)); }
  /* The sun goes along an arc: it turns about a point far below the ground. */
  .scene-days .sun { transform-origin: 600px 640px; transform: rotate(calc((var(--p) - 0.5) * 34deg)); }

  /* Small motions that start when the drawing is in view. */
  .scene .flag { transform-origin: 590px 142px; transform: rotate(90deg); transition: transform 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) 0.9s; }
  .scene.in .flag, html:not(.js) .scene .flag { transform: none; }
  .scene .pin { transform-origin: 748px 172px; }
  .js .scene .pin { transform: scale(0.4); transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s; }
  .js .scene.in .pin { transform: none; }
  .scene .board { transform-origin: 600px 120px; }
  .js .scene .board { opacity: 0; transform: translateX(-14px); transition: opacity 0.5s var(--ease), transform 0.8s var(--glide); }
  .js .scene .board.b2 { transform: translateX(14px); transition-delay: 0.55s; }
  .js .scene .board.b1 { transition-delay: 0.4s; }
  .js .scene .board.b3 { transition-delay: 0.7s; }
  .js .scene.in .board { opacity: 1; transform: none; }
  .js .scene .bird { opacity: 0; transform: translate(-40px, -30px); transition: opacity 0.4s var(--ease) 1s, transform 0.9s var(--glide) 1s; }
  .js .scene.in .bird { opacity: 1; transform: none; }
  .scene .lid { transform-origin: 548px 170px; transition: transform 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) 0.8s; }
  .js .scene .lid { opacity: 0; }
  .js .scene.in .lid { opacity: 1; transform: translateY(-12px) rotate(-7deg); transition: transform 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) 0.9s, opacity 0.5s var(--ease) 0.4s; }

  /* Sapporo: the tail moves from side to side. In the car, the ear moves in the wind. */
  .scene .tail { transform-box: fill-box; transform-origin: 100% 100%; animation: wag 0.45s ease-in-out infinite alternate; }
  .scene .ear { transform-box: fill-box; transform-origin: 100% 60%; animation: flap 0.5s ease-in-out infinite alternate; }
