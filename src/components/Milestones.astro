---
import { story } from '../data/wedding';

// Small line drawings, one for each milestone, in the same order as `story`.
// Each is drawn on a 48 x 48 grid with the moss stroke. To add a milestone,
// add it to `story` in wedding.ts and add a drawing here (or reuse one).
const icons = [
  // We met: two people side by side.
  `<circle cx="18" cy="17" r="5"/><path d="M9 36c0-6 4-10 9-10s9 4 9 10"/><circle cx="31" cy="19" r="4.5"/><path d="M24 36c1-5 4-8 7-8s7 3 8 8"/><path d="M24.5 8.5l1 2.5 2.5 1-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1z" class="fill"/>`,
  // We started dating: a heart.
  `<path d="M24 37s-12-7.5-12-16a6.5 6.5 0 0 1 12-3.5A6.5 6.5 0 0 1 36 21c0 8.5-12 16-12 16z" class="fill"/>`,
  // Our house: a small house with a chimney.
  `<path d="M10 23 24 11l14 12"/><path d="M14 20v17h20V20"/><path d="M21 37v-8h6v8"/><path d="M31 15v-4h3v6.5"/>`,
  // Engaged: a ring in front of a mountain.
  `<path d="M6 34 17 19l6 7 5-5 14 13" class="soft"/><circle cx="24" cy="31" r="6.5"/><path d="M21 22.5h6l-3 3.5z" class="fill"/>`,
  // Sapporo: a paw print.
  `<ellipse cx="24" cy="30" rx="7" ry="6" class="fill"/><ellipse cx="14.5" cy="22" rx="2.8" ry="3.6" class="fill"/><ellipse cx="20" cy="16" rx="2.8" ry="3.6" class="fill"/><ellipse cx="28" cy="16" rx="2.8" ry="3.6" class="fill"/><ellipse cx="33.5" cy="22" rx="2.8" ry="3.6" class="fill"/>`,
  // We get married: a castle tower.
  `<path d="M13 37V17h4v3h4v-3h6v3h4v-3h4v20z"/><path d="M21 37v-6a3 3 0 0 1 6 0v6"/><path d="M24 17V9l5 2-5 2"/>`,
];
---

<!-- A horizontal line of milestones. On a phone it scrolls sideways. -->
<div class="milestones reveal">
  <ol aria-label="Milestones, oldest first">
    {
      story.map((item, i) => (
        <li class:list={['stop', { last: i === story.length - 1 }]} style={`--n: ${i}`}>
          <span class="badge" aria-hidden="true">
            <svg viewBox="0 0 48 48" set:html={icons[i] ?? icons[1]} />
          </span>
          <p class="label">{item.date}</p>
          <h3>{item.title}</h3>
          {item.text && <p class="muted note">{item.text}</p>}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .milestones { overflow-x: auto; scroll-snap-type: x proximity; scroll-padding-inline: var(--gutter); margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter) 8px; scrollbar-width: thin; }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(140px, 1fr));
    gap: 0 20px;
    position: relative;
    min-width: max-content;
  }
  @media (min-width: 1000px) { ol { min-width: 0; } }
  /* The line runs through the middle of the badges. It draws from left to right. */
  ol::before {
    content: '';
    position: absolute;
    left: 32px;
    right: 32px;
    top: 32px;
    height: 1px;
    background: var(--text);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 1.6s var(--glide) 0.1s;
  }
  .milestones.in ol::before, :global(html:not(.js)) ol::before { transform: none; }
  .stop { scroll-snap-align: start; position: relative; }
  .badge {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line);
    margin-bottom: 16px;
    position: relative;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--glide), border-color 0.3s var(--ease);
    transition-delay: calc(0.3s + var(--n) * 0.18s);
  }
  .milestones.in .badge, :global(html:not(.js)) .badge { opacity: 1; transform: none; }
  .last .badge { border-color: var(--accent); }
  .stop:hover .badge { border-color: var(--accent); }
  svg { width: 40px; height: 40px; fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  svg :global(.fill) { fill: color-mix(in srgb, var(--accent) 18%, transparent); }
  svg :global(.soft) { stroke: var(--muted); }
  .label { margin: 0 0 6px; }
  h3 { margin: 0; font-family: var(--display); font-weight: 400; font-size: 1.45rem; line-height: 1.15; letter-spacing: -0.01em; max-width: 12ch; }
  .note { margin: 8px 0 0; font-size: 0.95rem; max-width: 22ch; }
  @media (prefers-reduced-motion: reduce) {
    ol::before, .badge { transition: none; transform: none; opacity: 1; }
  }
</style>
