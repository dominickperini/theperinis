---
import { faq } from '../data/wedding';
---

<!-- All answers are visible. Nothing to click. -->
<dl class="faq">
  {
    faq.map((item) => (
      <div class="q reveal">
        <dt>{item.q}</dt>
        <dd>{item.a}</dd>
      </div>
    ))
  }
</dl>

<style>
  .faq { margin: 0; display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--line); }
  @media (min-width: 720px) { .faq { grid-template-columns: 1fr 1fr; column-gap: 40px; } }
  .q { border-bottom: 1px solid var(--line); padding: 22px 0 24px; }
  dt {
    font-family: var(--display);
    font-size: 1.45rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }
  dd { margin: 0; color: var(--muted); max-width: 46ch; }
</style>
