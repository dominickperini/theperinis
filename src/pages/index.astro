---
import Layout from '../layouts/Layout.astro';
import { wedding } from '../data/wedding';

// Show the weekday on its own line, like a spec sheet: "September 5, 2027" / "Sunday".
const [weekday, ...rest] = wedding.date.split(', ');
const dateMain = rest.length ? rest.join(', ') : wedding.date;
const dateSub = rest.length ? weekday : '';

const links = [
  { href: '/story', title: 'Our Story', text: 'How it all started.' },
  { href: '/schedule', title: 'Schedule', text: 'Times and places for the weekend.' },
  { href: '/travel', title: 'Travel', text: 'Airports, hotels, and directions.' },
  { href: '/faq', title: 'FAQ', text: 'Answers to common questions.' },
];
---

<Layout>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow rise" style="--i: 0">We are getting married</p>
      <h1 class="names">
        <span class="line"><span class="rise" style="--i: 1">{wedding.couple.first}</span></span>
        <span class="line"><span class="rise" style="--i: 2"><em>&amp;</em> {wedding.couple.second}</span></span>
      </h1>

      <dl class="specs rise" style="--i: 3">
        <div>
          <dt class="eyebrow">Date</dt>
          <dd>{dateMain}{dateSub && <><br /><span class="muted">{dateSub}</span></>}</dd>
        </div>
        <div>
          <dt class="eyebrow">Place</dt>
          <dd>{wedding.venue.name}<br /><span class="muted">{wedding.city}</span></dd>
        </div>
        {
          wedding.dateISO && (
            <div class="countdown" data-date={wedding.dateISO} hidden>
              <dt class="eyebrow">Days to go</dt>
              <dd><span class="count">0</span></dd>
            </div>
          )
        }
      </dl>

      <div class="cta rise" style="--i: 4">
        <a class="button" href="/rsvp">RSVP <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <p class="muted small">Please reply before {wedding.rsvpDeadline}.</p>
      </div>
    </div>

    <div class="swatch" aria-hidden="true"><div class="weave"></div></div>
  </section>

  <nav class="index" aria-label="More about the wedding">
    {
      links.map((link, i) => (
        <a class="index-link reveal" href={link.href} style={`--delay: ${i * 0.07}s`}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <span class="title">{link.title}</span>
          <span class="text muted">{link.text}</span>
          <span class="go" aria-hidden="true">&rarr;</span>
        </a>
      ))
    }
  </nav>
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: 8px 20px 72px;
    display: grid;
    gap: 40px;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.35fr 1fr;
      align-items: stretch;
      gap: 72px;
      padding-top: 32px;
      padding-bottom: 104px;
    }
  }

  .names {
    font-size: clamp(3.4rem, 15vw, 7.5rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.045em;
    margin: 18px 0 44px;
  }
  .names .line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .names .line > span { display: inline-block; }
  .names em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--accent);
    margin-right: 0.04em;
  }

  /* Load animation: each part rises into place, one after the other. */
  .rise { animation: rise 1.1s var(--ease) both; animation-delay: calc(0.15s + var(--i) * 0.12s); }
  .line > .rise { animation-name: rise-line; animation-duration: 1.3s; }
  @keyframes rise { from { opacity: 0; transform: translateY(22px); } }
  @keyframes rise-line { from { transform: translateY(105%); } }

  /* Facts in the style of a spec sheet. */
  .specs {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0 0 40px;
    border-top: 1px solid var(--line);
  }
  .specs > div { padding: 16px 0; border-bottom: 1px solid var(--line); }
  .specs dt { margin: 0 0 4px; }
  .specs dd { margin: 0; font-size: 1.02rem; line-height: 1.45; }
  .count {
    font-family: var(--display);
    font-weight: 300;
    font-size: 2.4rem;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 560px) {
    .specs { grid-template-columns: repeat(3, auto); border-bottom: 1px solid var(--line); }
    .specs > div { border-bottom: 0; padding: 18px 24px 18px 0; }
    .specs > div + div { border-left: 1px solid var(--line); padding-left: 24px; }
  }

  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; }
  .cta .small { margin: 0; font-size: 0.88rem; }
  .arrow { transition: transform 0.45s var(--ease); }
  .button:hover .arrow { transform: translateX(4px); }

  /* The houndstooth swatch: it opens like a curtain, then the weave moves very slowly. */
  .swatch {
    position: relative;
    min-height: 140px;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--stone);
    animation: unveil 1.6s var(--ease) 0.35s both;
  }
  .weave {
    position: absolute;
    inset: -56px;
    background: var(--houndstooth) 0 0 / 28px 28px;
    opacity: 0.82;
    animation: drift 48s linear infinite;
  }
  .swatch::after {
    /* Soft light across the cloth, like a sample under a gallery lamp. */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(244, 242, 238, 0.35), transparent 45%, rgba(23, 23, 23, 0.12));
  }
  @keyframes unveil { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes drift { to { transform: translate(56px, 56px); } }
  @keyframes unveil-down { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @media (min-width: 900px) {
    .swatch { min-height: 0; animation-name: unveil-down; }
  }

  /* ---------- Index links ---------- */
  .index {
    max-width: 1060px;
    margin: 0 20px;
    border-top: 1px solid var(--text);
  }
  @media (min-width: 1100px) { .index { margin: 0 auto; } }
  .index-link {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    grid-template-areas: 'num title go' 'num text go';
    align-items: baseline;
    column-gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--text);
    position: relative;
  }
  .index-link::before {
    /* A graphite line runs across the row on hover. */
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--text);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease);
  }
  .index-link:hover { color: var(--text); }
  .index-link:hover::before { transform: scaleX(1); transform-origin: left; }
  .num { grid-area: num; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; color: var(--muted); font-variant-numeric: tabular-nums; }
  .title {
    grid-area: title;
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
    transition: transform 0.6s var(--ease);
  }
  .text { grid-area: text; font-size: 0.95rem; }
  .go { grid-area: go; align-self: center; font-size: 1.3rem; transition: transform 0.6s var(--ease); }
  .index-link:hover .title { transform: translateX(6px); }
  .index-link:hover .go { transform: translateX(6px); }
  @media (min-width: 720px) {
    .index-link { grid-template-columns: 64px 1fr 1fr auto; grid-template-areas: 'num title text go'; }
  }
</style>

<script>
  // Count up to the number of days before the wedding.
  const box = document.querySelector<HTMLElement>('.countdown');
  const out = box?.querySelector<HTMLElement>('.count');
  if (box?.dataset.date && out) {
    const days = Math.ceil((new Date(box.dataset.date).getTime() - Date.now()) / 86400000);
    if (days > 0) {
      box.hidden = false;
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still) {
        out.textContent = String(days);
      } else {
        const start = performance.now() + 600;
        const length = 1800;
        const step = (now: number) => {
          const t = Math.min(Math.max((now - start) / length, 0), 1);
          const eased = 1 - Math.pow(1 - t, 4);
          out.textContent = String(Math.round(days * eased));
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
    }
  }
</script>
