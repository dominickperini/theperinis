---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { wedding } from '../data/wedding';
import { hero, fieldNotes } from '../data/media';
import { ridgePath, RIDGE_W, RIDGE_H } from '../lib/ridge';

// Show the weekday on its own line, like a field note: "September 5, 2027" / "Sunday".
const [weekday, ...rest] = wedding.date.split(', ');
const dateMain = rest.length ? rest.join(', ') : wedding.date;
const dateSub = rest.length ? weekday : '';

const links = [
  { href: '/story', title: 'Our Story', text: 'How it all started.' },
  { href: '/schedule', title: 'Schedule', text: 'Times and places for the weekend.' },
  { href: '/travel', title: 'Travel', text: 'Airports, hotels, and directions.' },
  { href: '/faq', title: 'FAQ', text: 'Answers to common questions.' },
];

// Layout of the field notes: each photo has its own place on the 12-column grid.
const spots = ['n1', 'n2', 'n3', 'n4', 'n5'];
---

<Layout>
  <section class="hero">
    <div class="hero-photo">
      <Photo media={hero} index={1} eager sizes="100vw" class="hero-figure" />
    </div>

    <div class="wide hero-text">
      <h1 class="names">
        <span class="line"><span class="rise" style="--i: 1">{wedding.couple.first}</span></span>
        <span class="line"><span class="rise" style="--i: 2"><em>&amp;</em> {wedding.couple.second}</span></span>
      </h1>

      <div class="hero-side rise" style="--i: 3">
        <p class="eyebrow">We are getting married</p>
        <dl class="specs">
          <div>
            <dt class="label">Date</dt>
            <dd>{dateMain}{dateSub && <><br /><span class="muted">{dateSub}</span></>}</dd>
          </div>
          <div>
            <dt class="label">Place</dt>
            <dd>{wedding.venue.name}<br /><span class="muted">{wedding.city}</span></dd>
          </div>
          {
            wedding.dateISO && (
              <div class="countdown" data-date={wedding.dateISO} hidden>
                <dt class="label">Days to go</dt>
                <dd class="count">0</dd>
              </div>
            )
          }
        </dl>
        <div class="cta">
          <a class="button" href="/rsvp">RSVP <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <p class="label small">Reply before {wedding.rsvpDeadline}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wide notes" aria-labelledby="notes-title">
    <header class="notes-head ruled reveal">
      <p class="label">§ 01</p>
      <h2 id="notes-title">Field notes</h2>
      <p class="lead">A few places and moments that brought us here.</p>
    </header>
    <div class="notes-grid">
      {
        fieldNotes.map((m, i) => (
          <Photo
            media={m}
            index={i + 2}
            class={`reveal ${spots[i % spots.length]}`}
            sizes="(min-width: 900px) 50vw, 100vw"
          />
        ))
      }
    </div>
  </section>

  <nav class="wide index" aria-label="More about the wedding">
    <p class="label index-label ruled reveal"><span>§ 02 &nbsp; The details</span></p>
    {
      links.map((link, i) => (
        <a class="index-link reveal" href={link.href} style={`--delay: ${i * 0.07}s`}>
          <span class="num label">{String(i + 1).padStart(2, '0')}</span>
          <span class="title">{link.title}</span>
          <span class="text muted">{link.text}</span>
          <span class="go" aria-hidden="true">&rarr;</span>
          <svg class="ridge" viewBox={`0 0 ${RIDGE_W} ${RIDGE_H}`} preserveAspectRatio="none" aria-hidden="true">
            <path d={ridgePath(5 + i * 13)} pathLength="1" />
          </svg>
        </a>
      ))
    }
  </nav>
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero { margin-top: -24px; padding-bottom: clamp(64px, 10vw, 128px); }
  .hero-photo { padding: 0 var(--gutter); max-width: 1600px; margin: 0 auto; }
  .hero-photo :global(.frame) {
    height: min(78svh, 860px);
    min-height: 360px;
  }
  /* The hero photo opens from the horizon: two panels move apart from the
     middle line. Then the view settles like a lens. Transform only, so it is smooth. */
  .hero-photo :global(.frame)::before, .hero-photo :global(.frame)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 50.5%;
    z-index: 1;
    background: var(--bg);
    animation: 1.1s var(--machined) 0.1s both;
  }
  .hero-photo :global(.frame)::before { top: 0; animation-name: open-up; }
  .hero-photo :global(.frame)::after { bottom: 0; animation-name: open-down; }
  @keyframes open-up { to { transform: translateY(-101%); } }
  @keyframes open-down { to { transform: translateY(101%); } }
  .hero-photo :global(.frame > *) { animation: lens 1.6s var(--glide) 0.1s both; }
  @keyframes lens { from { transform: scale(1.06); } }
  @media (max-width: 720px) { .hero-photo :global(.frame) { height: 58svh; min-height: 320px; } }
  .hero-photo :global(figcaption) { animation: rise 0.6s var(--glide) 0.7s both; }

  .hero-text {
    display: grid;
    gap: 32px;
    margin-top: clamp(28px, 5vw, 56px);
  }
  @media (min-width: 960px) {
    .hero-text { grid-template-columns: 7fr 5fr; align-items: end; gap: 56px; }
  }

  .names {
    font-size: clamp(3.8rem, 14vw, 9.5rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .names .line { display: block; overflow: hidden; padding: 0 0 0.14em 0.1em; margin: 0 0 -0.06em -0.1em; }
  .names .line > span { display: inline-block; }
  .names em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--accent);
    margin-right: 0.06em;
  }

  /* Load animation: each part rises into place, one after the other. */
  .rise { animation: rise 0.7s var(--glide) both; animation-delay: calc(0.25s + var(--i) * 0.1s); }
  .line > .rise { animation-name: rise-line; animation-duration: 0.9s; }
  @keyframes rise { from { opacity: 0; transform: translateY(22px); } }
  @keyframes rise-line { from { transform: translateY(105%); } }

  .hero-side .eyebrow { margin: 0 0 14px; color: var(--accent); }
  .specs { display: grid; grid-template-columns: repeat(3, auto); margin: 0 0 28px; border-top: 1px solid var(--text); }
  .specs > div { padding: 14px 16px 14px 0; }
  .specs > div + div { border-left: 1px solid var(--line); padding-left: 16px; }
  .specs dt { margin: 0 0 6px; }
  .specs dd { margin: 0; font-size: 0.98rem; line-height: 1.4; }
  .count { font-family: var(--mono); font-variant-numeric: tabular-nums; display: flex; }
  /* Odometer: each digit is a reel that turns to its number. */
  .count :global(.reel) { display: inline-block; height: 1.4em; overflow: hidden; }
  .count :global(.reel > span) {
    display: flex;
    flex-direction: column;
    transition: transform var(--t, 2s) var(--glide);
    transition-delay: var(--d, 0s);
  }
  .count :global(.reel i) { font-style: normal; height: 1.4em; line-height: 1.4; }
  @media (max-width: 520px) {
    .specs { grid-template-columns: 1fr 1fr; }
    .specs > div + div:nth-child(3) { grid-column: 1 / -1; border-left: 0; padding-left: 0; border-top: 1px solid var(--line); }
  }

  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; }
  .cta .small { margin: 0; }

  /* ---------- Field notes ---------- */
  .notes { padding-bottom: clamp(72px, 10vw, 140px); }
  .notes-head {
    display: grid;
    gap: 8px 32px;
    border-top: 1px solid var(--text);
    padding-top: 18px;
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .notes-head h2 { margin: 0; }
  .lead { font-size: 1.15rem; line-height: 1.45; color: var(--muted); margin: 0; max-width: 28ch; }
  @media (min-width: 900px) {
    .notes-head { grid-template-columns: 2fr 6fr 4fr; align-items: baseline; }
  }

  .notes-grid { display: grid; gap: 48px 24px; }
  @media (min-width: 900px) {
    .notes-grid { grid-template-columns: repeat(12, 1fr); row-gap: 72px; }
    .notes-grid > :global(.n1) { grid-column: 1 / 8; }
    .notes-grid > :global(.n2) { grid-column: 9 / 13; align-self: end; }
    .notes-grid > :global(.n3) { grid-column: 3 / 11; }
    .notes-grid > :global(.n4) { grid-column: 1 / 6; }
    .notes-grid > :global(.n5) { grid-column: 7 / 13; margin-top: 120px; }
  }
  .notes-grid > :global(.n1) :global(.frame) { aspect-ratio: 4 / 5; }
  .notes-grid > :global(.n2) :global(.frame) { aspect-ratio: 1 / 1; }
  .notes-grid > :global(.n3) :global(.frame) { aspect-ratio: 16 / 9; }
  .notes-grid > :global(.n4) :global(.frame) { aspect-ratio: 3 / 4; }
  .notes-grid > :global(.n5) :global(.frame) { aspect-ratio: 4 / 3; }

  /* ---------- Index links ---------- */
  .index-label { border-top: 1px solid var(--text); padding-top: 18px; margin: 0 0 8px; }
  .index-link {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    grid-template-areas: 'num title go' 'num text go';
    align-items: baseline;
    column-gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--text);
    position: relative;
  }
  /* On hover a mountain ridgeline draws along the row, then fills with a pale moss. */
  .ridge {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 16px;
    overflow: visible;
    pointer-events: none;
  }
  .ridge path {
    fill: color-mix(in srgb, var(--accent) 0%, transparent);
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.8s var(--machined), fill 0.5s var(--ease);
  }
  .index-link:is(:hover, :focus-visible) .ridge path {
    stroke-dashoffset: 0;
    fill: color-mix(in srgb, var(--accent) 14%, transparent);
    transition-delay: 0s, 0.5s;
  }
  .index-link:hover { color: var(--text); }
  .index-link .num { transition: color 0.4s var(--machined); }
  .index-link:hover .num { color: var(--accent); }
  .num { grid-area: num; }
  .title {
    grid-area: title;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.8rem, 4.8vw, 2.8rem);
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .text { grid-area: text; font-size: 1rem; }
  .go { grid-area: go; align-self: center; font-size: 1.3rem; }
  @media (min-width: 720px) {
    .index-link { grid-template-columns: 2fr 6fr 4fr auto; grid-template-areas: 'num title text go'; }
  }
</style>

<script>
  // Days to the wedding, shown on odometer reels.
  const box = document.querySelector<HTMLElement>('.countdown');
  const out = box?.querySelector<HTMLElement>('.count');
  if (box?.dataset.date && out) {
    const days = Math.ceil((new Date(box.dataset.date).getTime() - Date.now()) / 86400000);
    if (days > 0) {
      box.hidden = false;
      out.setAttribute('aria-label', `${days} days`);
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const digits = String(days).split('');
      if (still) {
        out.textContent = String(days);
      } else {
        // Build one reel per digit. Digits on the right turn more times, like an odometer.
        out.textContent = '';
        digits.forEach((ch, i) => {
          const turns = digits.length - 1 - i;
          const reel = document.createElement('span');
          reel.className = 'reel';
          reel.setAttribute('aria-hidden', 'true');
          const strip = document.createElement('span');
          const stops = turns * 10 + Number(ch);
          for (let n = 0; n <= stops; n++) {
            const cell = document.createElement('i');
            cell.textContent = String(n % 10);
            strip.appendChild(cell);
          }
          strip.style.setProperty('--t', `${1 + turns * 0.25}s`);
          strip.style.setProperty('--d', `${0.5 + i * 0.06}s`);
          reel.appendChild(strip);
          out.appendChild(reel);
          requestAnimationFrame(() => requestAnimationFrame(() => {
            strip.style.transform = `translateY(-${(stops / (stops + 1)) * 100}%)`;
          }));
        });
      }
    }
  }
</script>
