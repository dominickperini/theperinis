---
import Layout from '../../layouts/Layout.astro';
import { wedding } from '../../data/wedding';
---

<Layout title="Thank you" noindex>
  <div class="container center">
    <p class="eyebrow">Address received</p>
    <h1>Thank you!</h1>
    <p>Watch your mailbox for our save the date. We hope that you can join us on {wedding.date}.</p>
    <p class="muted">To change your address, <a href="/address">send the form again</a>.</p>
  </div>
</Layout>

<style>
  .center { text-align: center; padding-top: 40px; }
</style>
