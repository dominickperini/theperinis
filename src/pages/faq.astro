---
import Layout from '../layouts/Layout.astro';
import { faq } from '../data/wedding';
---

<Layout title="FAQ">
  <div class="container">
    <div class="page-title">
      <p class="eyebrow">FAQ</p>
      <h1>Questions and answers</h1>
    </div>
    <div class="faq">
      <span class="marker" aria-hidden="true"></span>
      {
        faq.map((item) => (
          <details class="q">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  /* Plain questions between hairlines. A thin moss line glides beside the question
     that you point at or open (it moves up and down, along its own direction). */
  .faq { position: relative; border-top: 1px solid var(--line); }
  .q { border-bottom: 1px solid var(--line); padding: 0 0 0 20px; }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    font-family: var(--sans);
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker { display: none; }
  /* A plus sign that turns into a minus sign when the answer opens. */
  summary::after {
    content: '';
    flex: none;
    width: 14px;
    height: 14px;
    background:
      linear-gradient(currentColor, currentColor) center / 14px 1px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1px 14px no-repeat;
    transition: transform 0.5s var(--ease);
  }
  details[open] summary::after { transform: rotate(180deg); background-size: 14px 1px, 1px 0; }
  details p { margin: 0 0 20px; color: var(--muted); max-width: 60ch; }
  .marker {
    position: absolute; left: 0; top: 0; width: 1px; height: 1px; background: var(--accent);
    transform-origin: top; transform: translateY(var(--y, 0px)) scaleY(var(--h, 0));
    transition: transform 0.55s var(--glide);
  }
  @media (prefers-reduced-motion: reduce) { .marker { transition: none; } }
</style>

<script>
  const box = document.querySelector<HTMLElement>('.faq');
  const marker = box?.querySelector<HTMLElement>('.marker');
  const qs = [...(box?.querySelectorAll<HTMLDetailsElement>('.q') ?? [])];
  if (box && marker) {
    const place = (q?: HTMLElement) => {
      if (!q) { marker.style.setProperty('--h', '0'); return; }
      marker.style.setProperty('--y', `${q.offsetTop + 14}px`);
      marker.style.setProperty('--h', String(Math.max(1, q.offsetHeight - 28)));
    };
    const rest = () => place(qs.find((q) => q.open));
    qs.forEach((q) => {
      q.addEventListener('pointerenter', () => place(q));
      q.addEventListener('focusin', () => place(q));
      q.addEventListener('toggle', () => requestAnimationFrame(() => place(q.open ? q : qs.find((x) => x.open))));
    });
    box.addEventListener('pointerleave', rest);
    window.addEventListener('resize', rest);
  }
</script>
