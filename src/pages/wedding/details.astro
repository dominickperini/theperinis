---
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import Faq from '../../components/Faq.astro';
import Milestones from '../../components/Milestones.astro';
import { schedule, travel, wedding, registry } from '../../data/wedding';

// One page for everything a guest needs, in reading order. Nothing is hidden
// behind a click. Each part has its own anchor, so old links (/schedule,
// /travel, /registry, /faq) go to the correct place.
const parts = [
  { id: 'schedule', title: 'Schedule', lead: 'The plan for the weekend.' },
  { id: 'travel', title: 'Travel', lead: 'How to get here, and where to stay.' },
  { id: 'registry', title: 'Registry', lead: 'Gifts, if you want to.' },
  { id: 'faq', title: 'Questions', lead: 'Answers to common questions.' },
  { id: 'milestones', title: 'Milestones', lead: 'The big days so far.' },
];
const num = (i: number) => String(i + 1).padStart(2, '0');
const [weekday, ...rest] = wedding.date.split(', ');
---

<Layout title="Details">
  <div class="wide">
    <header class="intro-head">
      <p class="eyebrow">The details</p>
      <h1>The weekend</h1>
      <dl class="specs">
        <div><dt class="label">Date</dt><dd>{rest.join(', ')}<br /><span class="muted">{weekday}</span></dd></div>
        <div><dt class="label">Place</dt><dd>{wedding.venue.name}<br /><span class="muted">{wedding.city}</span></dd></div>
        <div class="rsvp"><dt class="label">RSVP</dt><dd>By {wedding.rsvpDeadline.replace(/^\w+, /, '')}<br /><a href="/wedding/rsvp">Reply now</a></dd></div>
      </dl>
    </header>

    <nav class="contents" aria-label="On this page">
      {parts.map((p, i) => (
        <a class="toc" href={`#${p.id}`}><span class="label">{num(i)}</span><span class="t">{p.title}</span></a>
      ))}
    </nav>

    <!-- 01 Schedule -->
    <section class="part" id="schedule" aria-labelledby="schedule-title">
      <header class="part-head ruled reveal">
        <p class="label">§ {num(0)}</p>
        <h2 id="schedule-title">{parts[0].title}</h2>
        <p class="lead">{parts[0].lead}</p>
      </header>
      <div class="part-body">
        {schedule.map((day) => (
          <div class="day">
            <h3 class="label day-name">{day.day}</h3>
            <ol class="events">
              {day.events.map((event) => (
                <li class="event reveal">
                  <p class="time">{event.time}</p>
                  <div>
                    <h4>{event.name}</h4>
                    {event.place && <p class="muted">{event.place}</p>}
                    {event.details && <p class="small">{event.details}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>

    <!-- 02 Travel -->
    <section class="part" id="travel" aria-labelledby="travel-title">
      <header class="part-head ruled reveal">
        <p class="label">§ {num(1)}</p>
        <h2 id="travel-title">{parts[1].title}</h2>
        <p class="lead">{parts[1].lead}</p>
      </header>
      <div class="part-body">
        <div class="venue reveal">
          <p class="label">The venue</p>
          <p class="venue-name">{wedding.venue.name}</p>
          <p class="muted">{wedding.venue.address}</p>
          {wedding.venue.mapUrl && (
            <a class="button" href={wedding.venue.mapUrl} target="_blank" rel="noopener">Open the map <Arrow /></a>
          )}
        </div>

        <div class="cols">
          <div class="col reveal">
            <h3 class="label">Fly in</h3>
            {travel.airports.map((a) => (
              <p><strong>{a.name}</strong><br /><span class="muted">{a.note}</span></p>
            ))}
          </div>
          <div class="col reveal" style="--delay: 0.07s">
            <h3 class="label">Stay</h3>
            {travel.hotels.map((h) => (
              <p>
                <strong>{h.url ? <a href={h.url} target="_blank" rel="noopener">{h.name}</a> : h.name}</strong><br />
                <span class="muted">{h.address}</span><br />
                {h.note}
              </p>
            ))}
          </div>
          <div class="col reveal" style="--delay: 0.14s">
            <h3 class="label">Get around</h3>
            <p>{travel.gettingAround}</p>
          </div>
        </div>

        <div class="todo reveal">
          <h3 class="label">While you are here</h3>
          <ul>{travel.thingsToDo.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </section>

    <!-- 03 Registry -->
    <section class="part" id="registry" aria-labelledby="registry-title">
      <header class="part-head ruled reveal">
        <p class="label">§ {num(2)}</p>
        <h2 id="registry-title">{parts[2].title}</h2>
        <p class="lead">{parts[2].lead}</p>
      </header>
      <div class="part-body">
        <p class="statement reveal">{registry.intro}</p>
        <div class="stores reveal">
          {registry.links.map((r) =>
            r.url ? (
              <a class="button" href={r.url} target="_blank" rel="noopener">{r.name} <Arrow /></a>
            ) : (
              <span class="store">{r.name}</span>
            ),
          )}
        </div>
      </div>
    </section>

    <!-- 04 Questions -->
    <section class="part" id="faq" aria-labelledby="faq-title">
      <header class="part-head ruled reveal">
        <p class="label">§ {num(3)}</p>
        <h2 id="faq-title">{parts[3].title}</h2>
        <p class="lead">{parts[3].lead}</p>
      </header>
      <div class="part-body"><Faq /></div>
    </section>

    <!-- 05 Milestones -->
    <section class="part story" id="milestones" aria-labelledby="story-title">
      <header class="part-head ruled reveal">
        <p class="label">§ {num(4)}</p>
        <h2 id="story-title">{parts[4].title}</h2>
        <p class="lead">{parts[4].lead}</p>
      </header>
      <Milestones />
    </section>

    <aside class="end reveal">
      <p class="end-title">See you on {rest.join(', ').replace(/, \d{4}$/, '')}.</p>
      <a class="button" href="/wedding/rsvp">RSVP <Arrow /></a>
    </aside>
  </div>
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }

  /* ---------- Top ---------- */
  .intro-head { padding: clamp(16px, 4vw, 48px) 0 clamp(32px, 5vw, 56px); }
  .intro-head .eyebrow { color: var(--accent); margin: 0 0 12px; }
  .intro-head h1 {
    font-size: clamp(3.4rem, 11vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 clamp(28px, 4vw, 48px);
  }
  .specs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--text); margin: 0; max-width: 820px; }
  .specs > div { padding: 14px 16px 0 0; }
  .specs > div + div { border-left: 1px solid var(--line); padding-left: 16px; }
  .specs dt { margin: 0 0 6px; }
  .specs dd { margin: 0; line-height: 1.4; }
  @media (max-width: 560px) {
    .specs { grid-template-columns: 1fr 1fr; }
    .specs > div + div.rsvp { grid-column: 1 / -1; border-left: 0; padding-left: 0; border-top: 1px solid var(--line); margin-top: 14px; }
  }

  /* A table of contents: all parts are on one page, so these only scroll. */
  .contents { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); border-top: 1px solid var(--line); }
  .contents a {
    display: flex; align-items: baseline; gap: 10px; padding: 14px 12px 14px 0;
    border-bottom: 1px solid var(--line); text-decoration: none; color: var(--text);
  }
  .contents .t { font-family: var(--display); font-size: 1.35rem; transition: color 0.3s var(--ease); }
  .contents a:is(:hover, :focus-visible) .t { color: var(--accent); }

  /* ---------- Parts: heading on the left, content on the right ---------- */
  .part { padding-top: clamp(64px, 9vw, 120px); scroll-margin-top: 64px; display: grid; gap: 0 48px; }
  .part-head { border-top: 1px solid var(--text); padding-top: 18px; margin-bottom: 28px; display: grid; gap: 6px; align-content: start; }
  .part-head h2 { margin: 0; }
  .part-head .label, .part-head .lead { margin: 0; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 26ch; }
  @media (min-width: 900px) {
    .part:not(.story) { grid-template-columns: 4fr 8fr; }
    .part:not(.story) .part-head { position: sticky; top: 88px; align-self: start; }
    .part-body { padding-top: 18px; }
  }

  /* Schedule */
  .day + .day { margin-top: 40px; }
  .day-name { margin: 0 0 4px; color: var(--accent); }
  .events { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .event { display: grid; grid-template-columns: 120px 1fr; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .event h4 { margin: 0 0 2px; font-family: var(--display); font-weight: 400; font-size: 1.6rem; line-height: 1.15; }
  .event p { margin: 0; }
  .event .small { margin-top: 6px; }
  .time { font-size: 0.95rem; letter-spacing: 0.04em; color: var(--accent); padding-top: 8px; font-variant-numeric: tabular-nums; }
  @media (max-width: 520px) { .event { grid-template-columns: 1fr; gap: 2px; } .time { padding-top: 0; } }

  /* Travel */
  .venue { padding-bottom: 32px; border-bottom: 1px solid var(--line); }
  .venue .label { margin: 0 0 8px; }
  .venue-name { font-family: var(--display); font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1; margin: 0 0 8px; }
  .venue .muted { margin: 0 0 20px; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0 28px; }
  .col { padding: 24px 0; border-bottom: 1px solid var(--line); }
  .col h3, .todo h3 { margin: 0 0 10px; }
  .col p { margin: 0 0 12px; }
  .col p:last-child { margin: 0; }
  .todo { padding-top: 24px; }
  .todo ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px 28px; }
  .todo li::before { content: '— '; color: var(--accent); }

  /* Registry */
  .statement { font-family: var(--display); font-size: clamp(1.7rem, 3.4vw, 2.4rem); line-height: 1.2; letter-spacing: -0.01em; margin: 0 0 28px; max-width: 24ch; }
  .stores { display: flex; flex-wrap: wrap; gap: 16px; }
  .store { border: 1px solid var(--line); padding: 12px 18px; color: var(--muted); }

  /* The end */
  .end {
    margin: clamp(72px, 10vw, 140px) 0 clamp(24px, 4vw, 48px);
    border-top: 1px solid var(--text);
    padding-top: 28px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px;
  }
  .end-title { font-family: var(--display); font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1; margin: 0; }
</style>
