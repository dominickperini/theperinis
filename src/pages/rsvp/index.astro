---
import Layout from '../../layouts/Layout.astro';
import { wedding } from '../../data/wedding';
import { findParties, getParty, normalizeCode, type Party } from '../../lib/guests';

export const prerender = false;

const code = normalizeCode(Astro.url.searchParams.get('code') ?? '');
const last = (Astro.url.searchParams.get('last') ?? '').trim().slice(0, 60);
const errorCode = Astro.url.searchParams.get('error');

// Step 1: the guest types a last name. Step 2: the guest selects a party.
// Step 3: the RSVP form for that party (the party code is in the link).
let party: Party | null = null;
let matches: Party[] = [];
let lookupFailed = false;
try {
  if (code) {
    party = await getParty(code);
    if (party?.status === 'not_invited') party = null;
  } else if (last) {
    matches = await findParties(last);
  }
} catch (err) {
  console.error('Could not read the guest list', err);
  lookupFailed = true;
}
const searched = !code && !!last && !lookupFailed;

const messages: Record<string, string> = {
  name: 'Please type your name.',
  email: 'Please type a correct email address.',
  attending: 'Please tell us if you can attend.',
  code: 'We cannot find this invitation. Please search for your last name again.',
  server: 'We could not save your RSVP. Please try again, or send us an email.',
};
let error = errorCode ? (messages[errorCode] ?? messages.server) : '';
if (!error && lookupFailed) error = messages.server;
else if (!error && code && !party) error = messages.code;

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout title="RSVP">
  <div class="container">
    <div class="page-title">
      <p class="eyebrow">RSVP</p>
      <h1>Will you join us?</h1>
      <p>Please reply before {wedding.rsvpDeadline}.</p>
    </div>

    {error && <p class="error card" role="alert">{error}</p>}

    {
      !party && (
        <form class="card" method="get" action="/rsvp" role="search">
          <label>
            Your last name
            <input name="last" required minlength="2" maxlength="60" value={last} autocomplete="family-name" />
            <small class="muted">Type the last name that is on your invitation.</small>
          </label>
          <button class="button" type="submit">Find my invitation</button>
        </form>
      )
    }

    {
      searched && matches.length > 0 && (
        <div class="card results" aria-live="polite">
          <p class="party">Select your party.</p>
          <ul>
            {matches.map((p) => (
              <li>
                <a href={`/rsvp?code=${p.code}`}>
                  <strong>{p.name}</strong>
                  <span class="muted">{p.seats} {p.seats === 1 ? 'seat' : 'seats'}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="muted small">Your party is not here? Search for a different last name in your party.</p>
        </div>
      )
    }

    {
      searched && matches.length === 0 && (
        <p class="card" role="status">
          We cannot find an invitation with the last name "{last}". Make sure that the spelling is correct, or
          search for a different last name in your party.
          {wedding.contactEmail && !wedding.contactEmail.startsWith('[') && <> You can also send an email to {wedding.contactEmail}.</>}
        </p>
      )
    }

    {party && (

    <form class="card" method="post" action="/api/rsvp">
      <input type="hidden" name="code" value={party.code} />
      <p class="party">
        Invitation for <strong>{party.name}</strong>
        <br /><span class="muted">We saved {party.seats} {party.seats === 1 ? 'seat' : 'seats'} for you.</span>
      </p>
      <label>
        Your full name
        <input name="name" required autocomplete="name" maxlength="200" />
      </label>

      <label>
        Email
        <input name="email" type="email" required autocomplete="email" maxlength="200" />
        <small class="muted">We use your email only to send you wedding updates.</small>
      </label>

      <fieldset>
        <legend>Can you attend?</legend>
        <label class="choice"><input type="radio" name="attending" value="yes" required /> Yes, I will be there</label>
        <label class="choice"><input type="radio" name="attending" value="no" /> No, I cannot attend</label>
      </fieldset>

      <div class="if-yes">
        <label>
          Number of guests who will come (include yourself)
          <input name="guests" type="number" min="1" max={party.seats} value={party.seats} inputmode="numeric" />
        </label>

        <label>
          Names of the other guests in your party
          <input name="guestNames" maxlength="500" />
        </label>

        <label>
          Food allergies or diet needs
          <input name="dietary" maxlength="500" />
        </label>

        <label>
          A song that will get you dancing
          <input name="song" maxlength="200" />
        </label>
      </div>

      <label>
        A message for us (optional)
        <textarea name="message" rows="4" maxlength="2000"></textarea>
      </label>

      <!-- Bots fill this in. People do not see it. -->
      <label class="hp" aria-hidden="true">
        Website <input name="website" tabindex="-1" autocomplete="off" />
      </label>

      <button class="button" type="submit">Send RSVP</button>
      <p class="muted small">To change your reply, search for your name again and send the form again. <a href="/rsvp">This is not my party.</a></p>
    </form>
    )}
  </div>
</Layout>

<style>
  form { display: grid; gap: 20px; }
  label { display: grid; gap: 6px; font-weight: 600; font-size: 0.95rem; }
  input:not([type='radio']), textarea {
    font: inherit;
    font-weight: 400;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    width: 100%;
    transition: border-color 0.2s;
  }
  input:focus, textarea:focus { outline: 1px solid var(--text); outline-offset: 0; border-color: var(--text); }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
  legend { font-weight: 600; font-size: 0.95rem; margin-bottom: 6px; }
  .choice { display: flex; align-items: center; gap: 10px; font-weight: 400; font-size: 1rem; }
  .choice input { accent-color: var(--accent); width: 18px; height: 18px; }
  .if-yes { display: grid; gap: 20px; }
  .results { display: grid; gap: 16px; }
  .results ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .results li + li { border-top: 1px solid var(--line); }
  .results a { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 14px 0; color: inherit; text-decoration: none; }
  .results a:hover strong, .results a:focus-visible strong { text-decoration: underline; text-underline-offset: 4px; }
  small { font-weight: 400; }
  .small { font-size: 0.9rem; margin: 0; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .party { margin: 0; font-size: 1.05rem; }
  .error { border-color: #b4553f; color: #8a3a28; }
  button { justify-self: start; }
</style>

<script>
  // Show the guest questions only when the guest says yes.
  const form = document.querySelector<HTMLFormElement>('form[method="post"]');
  const extra = form?.querySelector<HTMLElement>('.if-yes');
  if (form && extra) {
    const sync = () => {
      extra.hidden = !!form.querySelector<HTMLInputElement>('input[name="attending"][value="no"]')?.checked;
    };
    form.addEventListener('change', sync);
    sync();
  }
</script>
