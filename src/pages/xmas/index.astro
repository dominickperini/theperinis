---
import Family from '../../layouts/Family.astro';

// Christmas lists. Not in the menu and not indexed. The page is static;
// the lists come from /api/xmas, which removes the surprise data when
// a person looks at their own list.
//
// The look: an evergreen branch with one ornament for each person (no menus),
// and a small drawn parcel for each gift (no check boxes).

// The branch is drawn here, at build time, in pieces that join end to end.
const W = 84;
const stemY = (x: number) => 16 + Math.sin((x / W) * Math.PI * 2) * 2.2;
function rng(seed: number) {
  let s = seed;
  return () => (s = (s * 16807) % 2147483647) / 2147483647;
}
const f = (n: number) => n.toFixed(1);
function piece(seed: number, from = 0, to = W, taper: 'none' | 'tip' | 'base' = 'none') {
  const r = rng(seed);
  let stem = '';
  for (let x = from; x <= to; x += 6) stem += `${x === from ? 'M' : 'L'}${f(x)} ${f(stemY(x))}`;
  let needles = '';
  for (let x = from + 1; x < to; x += 2.9) {
    const px = x + (r() - 0.5) * 1.6;
    const py = stemY(px);
    const t = (px - from) / (to - from);
    // A tip gets shorter needles to its end. A cut base has few needles.
    const scale = taper === 'tip' ? 1 - t * 0.75 : taper === 'base' ? Math.max(0, t * 1.6 - 0.5) : 1;
    for (const side of [-1, 1]) {
      if (r() < 0.1 || scale <= 0.05) continue;
      const len = (8 + r() * 6) * scale;
      const ang = (side * (36 + r() * 24) * Math.PI) / 180;
      needles += `M${f(px)} ${f(py)}L${f(px + Math.cos(ang) * len)} ${f(py + Math.sin(ang) * len)}`;
    }
  }
  if (taper === 'tip') needles += `M${f(to)} ${f(stemY(to))}l7 -1.5M${f(to)} ${f(stemY(to))}l6 2.5`;
  return { stem, needles };
}
const pieces = [11, 29, 47, 83].map((seed) => piece(seed));
const base = piece(5, 44, W, 'base');
const tip = piece(7, 0, 46, 'tip');
---

<Family title="Christmas lists" description="Our family Christmas lists." noindex>
  <div class="container xmas" id="xmas">
    <p class="eyebrow top">Christmas lists</p>
    <p class="whoami" id="whoami" hidden></p>

    <div class="bough-wrap" id="bough-wrap">
      <div class="bough" id="bough" role="tablist" aria-label="People"></div>
    </div>

    <form class="add-person composer" id="add-person" hidden>
      <label class="field">
        <span class="lab">Name</span>
        <input id="person-name" name="name" maxlength="40" placeholder="For example: Sarah" autocomplete="off" enterkeyhint="done" />
      </label>
      <div class="composer-end">
        <button class="primary" type="submit">
          <span id="person-submit">Add this person</span>
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M6 16.2 C12 15.6 19 16.4 25.5 16 M18.5 9.5 C20.5 12.5 22.8 14.6 25.5 16 C22.6 17.6 20.4 19.8 18.8 22.8" /></svg>
        </button>
        <button class="quiet" type="button" data-cancel>Cancel</button>
      </div>
    </form>

    <p class="error" id="error" role="alert" hidden></p>
    <div id="view" aria-live="polite"><p class="hint">Loading the lists…</p></div>

    {/* Branch pieces. The script copies them into the row of ornaments. */}
    {
      pieces.map((p, i) => (
        <template id={`seg-${i}`}>
          <svg class="seg" viewBox={`0 0 ${W} 34`} aria-hidden="true"><path class="needles" d={p.needles} /><path class="stem" d={p.stem} /></svg>
        </template>
      ))
    }
    <template id="seg-base">
      <svg class="seg" viewBox={`0 0 ${W} 34`} aria-hidden="true"><path class="needles" d={base.needles} /><path class="stem" d={base.stem} /></svg>
    </template>
    <template id="seg-tip">
      <svg class="seg" viewBox={`0 0 ${W} 34`} aria-hidden="true"><path class="needles" d={tip.needles} /><path class="stem" d={tip.stem} /></svg>
    </template>
  </div>
</Family>

<script>
  type Sizes = Record<string, string>;
  type Preview = { title?: string; image?: string; site?: string; price?: string };
  type Person = { id: string; name: string; count: number; sizes?: Sizes };
  type Gift = {
    id: string; owner: string; title: string; link?: string; note?: string;
    addedBy: string; idea: boolean; gotBy?: string; team?: string[]; createdAt: string;
    size?: string; preview?: Preview;
  };
  type Comment = { id: string; owner: string; gift?: string; by: string; text: string; createdAt: string };
  type View = { own: boolean; gifts: Gift[]; comments: Comment[] };
  type State = { people: Person[]; view: View | null };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const boughEl = $('bough');
  const boughWrap = $('bough-wrap');
  const whoEl = $('whoami');
  const viewEl = $('view');
  const errorEl = $('error');
  const addPersonForm = $<HTMLFormElement>('add-person');
  const personInput = $<HTMLInputElement>('person-name');

  const store = {
    get: (k: string) => { try { return localStorage.getItem(k) ?? ''; } catch { return ''; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode */ } },
  };

  let state: State = { people: [], view: null };
  let me = store.get('xmas-me');
  let list = new URL(location.href).searchParams.get('list') ?? store.get('xmas-list');
  let picking = !me;                 // true while the person selects "who are you"
  const open = new Set<string>();    // gifts with the note line open
  let editing = '';                  // gift id in edit mode
  let confirming = '';               // id waiting for a second tap to remove
  let seen = new Set<string>();      // ids already drawn (new ones animate in)
  let gotBefore = new Map<string, string>(); // gift id -> gotBy, to play the bow one time
  let boughKey = '';
  let lastData = '';
  let busy = false;
  let draftPreview: { url: string; data: Preview | null } | null = null; // the preview in the line for a new gift

  // ---------- small helpers ----------
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const person = (id?: string) => state.people.find((p) => p.id === id);
  const nameOf = (id?: string) => person(id)?.name ?? 'Someone';
  const initial = (id?: string) => (person(id)?.name ?? '?').trim().charAt(0).toUpperCase();
  const possessive = (n: string) => (n.endsWith('s') ? `${n}’` : `${n}’s`);
  const host = (link: string) => { try { return new URL(link).hostname.replace(/^www\./, ''); } catch { return 'link'; } };
  const hash = (s: string) => { let h = 0; for (const c of s) h = (h * 31 + c.charCodeAt(0)) >>> 0; return h; };
  /** "You and Sarah", "Sarah, Max and Ann". "You" is always first. */
  function names(ids: string[]) {
    const n = [...ids].sort((a, b) => Number(b === me) - Number(a === me)).map((id) => (id === me ? 'You' : nameOf(id)));
    return n.length < 2 ? (n[0] ?? '') : `${n.slice(0, -1).join(', ')} and ${n[n.length - 1]}`;
  }

  // ---------- drawings ----------
  const svg = (body: string, box = '0 0 32 32', cls = '') => `<svg class="${cls}" viewBox="${box}" aria-hidden="true">${body}</svg>`;
  const ICON = {
    arrow: svg('<path d="M6 16.2 C12 15.6 19 16.4 25.5 16 M18.5 9.5 C20.5 12.5 22.8 14.6 25.5 16 C22.6 17.6 20.4 19.8 18.8 22.8"/>'),
    bow: svg('<path d="M16 15.5 C11 5.5 2.5 9 6.5 14.6 C9.2 17.6 13.4 16.8 16 15.5 C18.8 5.5 29.8 8.2 25.8 14.4 C23 17.6 18.6 16.8 16 15.5 Z"/><path d="M16 15.5 C14.4 19.6 12.4 22.8 9.6 26 M16 15.5 C17.8 19.6 19.8 22.6 22.8 25.6"/>'),
    rings: svg('<path d="M12.2 9.2 C16.4 9 19.2 12 19.2 16 C19.2 20.2 16.2 23 12 23 C7.8 23 5 20 5 16 C5 12 8 9.4 12.2 9.2 Z"/><path d="M20.2 9.4 C24.4 9.4 27.2 12.2 27 16.2 C26.8 20.4 23.8 23 19.8 22.8 C15.8 22.6 13 19.8 13 16 C13 12 16 9.4 20.2 9.4 Z"/>'),
    undo: svg('<path d="M9 13.5 C14 9.5 22 10.5 24.5 16 C26.5 21 22 25.5 16.5 25.2 M9 13.5 L9.6 7.8 M9 13.5 L14.8 14.4"/>'),
    spark: svg('<path d="M10 1.8 C10.9 6.8 13 9.1 18.2 10 C13 10.9 10.9 13.2 10 18.2 C9.1 13.2 7 10.9 1.8 10 C7 9.1 9.1 6.8 10 1.8 Z"/>', '0 0 20 20', 'spark'),
    top: svg('<path d="M11 6 L5 9.6 L7.6 14.2 L10.6 12.6 L10.4 26 L21.6 26.2 L21.4 12.6 L24.4 14.2 L27 9.6 L21 6 C19.4 8.8 12.6 8.8 11 6 Z"/>'),
    bottom: svg('<path d="M10 5.5 L22 5.6 L23.6 27 L18.2 27.2 L16 12.4 L13.8 27.2 L8.4 27 Z M10 9 L22 9.1"/>'),
    shoe: svg('<path d="M4.6 21.6 L4.8 13.6 C7 14 8.6 12.8 9.2 10.8 L13 11.2 C14.6 15 18 17.2 23.8 17.8 C26.8 18.2 27.8 19.8 27.6 21.8 Z M4.6 24.6 L27.6 24.6"/>'),
    ring: svg('<path d="M16 11.6 C21 11.6 24.2 14.8 24.2 19.4 C24.2 24 20.8 27.2 16 27.2 C11.2 27.2 7.8 24 7.8 19.4 C7.8 14.8 11 11.6 16 11.6 Z M16 4.4 L19.4 7.9 L16 11.5 L12.6 7.9 Z"/>'),
    other: svg('<path d="M5.6 16.6 L15.6 6 L26 6.2 L26.2 16.6 L15.8 26.6 Z M21.2 10.8 L21.3 10.9"/>'),
    link: svg('<path d="M14 18.4 C11.6 20.8 8 20.9 6 18.8 C4 16.7 4.2 13.4 6.6 11.2 L10 8 C12.4 5.8 15.8 5.9 17.8 8 M18 13.6 C20.4 11.2 24 11.1 26 13.2 C28 15.3 27.8 18.6 25.4 20.8 L22 24 C19.6 26.2 16.2 26.1 14.2 24"/>'),
    down: svg('<path d="M9 5 C8 13 10.5 20 16.5 26 M16.5 26 L9.5 24.2 M16.5 26 L17.6 18.8"/>'),
    note: svg('<path d="M5.5 21.5 C3.5 12.5 11 6.5 25.5 7 C27.5 17 20.5 24.5 10 22.5 L5.6 26.6 Z"/>'),
  };
  const PARCELS = [
    '<path class="p-body" d="M7.5 18 L32.5 17.6 L32 35 L8 35.4 Z"/><path class="p-body" d="M5.5 11.6 L34.5 11.2 L34.6 17.4 L5.4 17.9 Z"/><path class="p-rib" d="M20 11.4 L20.2 35.2"/>',
    '<path class="p-body" d="M11.5 12.4 L28.6 12 L28.2 35.2 L11.9 35.5 Z"/><path class="p-rib" d="M20 12.2 L20.1 35.3 M11.7 23.6 L28.4 23.2"/>',
    '<path class="p-body" d="M8.5 23.5 C8 15.5 14 12 20 12 C26.5 12 32 15.5 31.6 23.5 C31.2 31.5 26.5 35.5 20 35.5 C13.5 35.5 9 31.5 8.5 23.5 Z"/><path class="p-rib" d="M20 12 C19.4 20 19.8 28 20.1 35.5"/>',
  ];
  const BOW = '<g class="p-bow"><path d="M20 11.6 C15.5 3.5 7.5 5.5 11 10 C13.5 12.6 17.5 12.4 20 11.6 C22.5 3.5 31.5 5 28.6 10 C26.4 12.6 22.4 12.4 20 11.6 Z"/><path d="M20 11.6 L16.2 16.6 M20 11.6 L24 16.4"/></g>';
  const parcel = (id: string) => svg(PARCELS[hash(id) % PARCELS.length] + BOW, '0 0 40 40');

  // ---------- sizes ----------
  const SIZES: [key: string, label: string, hint: string][] = [
    ['top', 'Tops', 'M'],
    ['bottom', 'Bottoms', '32 × 32'],
    ['shoe', 'Shoes', '10.5'],
    ['ring', 'Ring', '7'],
    ['other', 'Other', 'Hat, jacket, gloves…'],
  ];
  const sizeIcon = (key: string) => (ICON as Record<string, string>)[key];
  /** "shirt M · shoe 10.5": the sizes of a person, as small drawn tags. */
  function sizeTags(sizes: Sizes | undefined) {
    return SIZES.filter(([k]) => sizes?.[k])
      .map(([k, label]) => `<span class="size-tag" title="${label}">${sizeIcon(k)}<span class="sr">${label}: </span>${esc(sizes![k])}</span>`)
      .join('');
  }
  function sizesHtml(p: Person, own: boolean) {
    const tags = sizeTags(p.sizes);
    if (!own) return tags ? `<p class="sizes-line">${tags}</p>` : '';
    return `
      <details class="sizes" data-keep="sizes">
        <summary>${tags ? `${tags}<span class="edit">Change my sizes</span>` : `<span class="size-tag">${ICON.top}</span><span class="edit">Add my sizes (optional)</span>`}</summary>
        <p class="help center">All are optional. Fill in what you know. They save by themselves. <span class="saved" id="sizes-saved"></span></p>
        <form class="size-grid" data-form="sizes">
          ${SIZES.map(([k, label, hint]) => `
            <label class="size size-${k}">
              <span class="size-name">${sizeIcon(k)}${label}</span>
              <input name="${k}" maxlength="${k === 'other' ? 120 : 30}" placeholder="${hint}" value="${esc(p.sizes?.[k] ?? '')}" autocomplete="off" enterkeyhint="done" />
            </label>`).join('')}
        </form>
      </details>`;
  }

  // ---------- link previews ----------
  const looksLikeLink = (v: string) => /^(https?:\/\/|www\.)\S+\.\S+$/i.test(v.trim());
  function card(link: string, pv: Preview | undefined | null) {
    if (!pv || (!pv.title && !pv.image)) {
      return `<p class="gift-link"><a href="${esc(link)}" target="_blank" rel="noopener noreferrer nofollow">${esc(host(link))} ↗</a></p>`;
    }
    const image = pv.image?.startsWith('https://') ? pv.image : '';
    return `
      <a class="pv${image ? '' : ' no-img'}" href="${esc(link)}" target="_blank" rel="noopener noreferrer nofollow">
        ${image ? `<span class="pv-img"><img src="${esc(image)}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></span>` : ''}
        <span class="pv-text">
          <strong>${esc(pv.title ?? host(link))}</strong>
          <small>${esc(pv.site ?? host(link))}${pv.price ? ` · ${esc(pv.price)}` : ''}</small>
        </span>
      </a>`;
  }

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.hidden = !msg;
  }

  // ---------- talk to the server ----------
  // Requests run one at a time, in order, so a quick second tap is not lost.
  let queue: Promise<unknown> = Promise.resolve();
  function call(body?: Record<string, unknown>): Promise<any> {
    const next = queue.then(() => send(body));
    queue = next.catch(() => null);
    return next;
  }

  async function send(body?: Record<string, unknown>, quiet = false) {
    busy = true;
    try {
      const res = body
        ? await fetch('/api/xmas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ me, list, ...body }),
          })
        : await fetch(`/api/xmas?me=${encodeURIComponent(me)}&list=${encodeURIComponent(list)}`, { cache: 'no-store' });
      const text = await res.text();
      let data: any;
      try { data = JSON.parse(text); } catch { data = { error: 'server' }; }
      if (!res.ok) {
        if (!quiet) {
          showError(
            data.error === 'server' || data.error === 'storage' || data.error === 'bad request'
              ? 'Something went wrong. Please try again.'
              : data.error,
          );
        }
        if (body) await send(undefined, true);
        return null;
      }
      if (!quiet) showError('');
      // Draw again only when something changed.
      const { person: _p, ...rest } = data;
      const key = JSON.stringify(rest);
      state = rest;
      if (key !== lastData || !quiet) render();
      lastData = key;
      return data;
    } catch {
      if (!quiet) showError('We cannot reach the website. Check your connection and try again.');
      return null;
    } finally {
      busy = false;
    }
  }

  // ---------- the branch of ornaments ----------
  function segment(name: string) {
    return (document.getElementById(`seg-${name}`) as HTMLTemplateElement).innerHTML;
  }

  function renderBough() {
    const key = JSON.stringify(state.people.map((p) => [p.id, p.name]));
    if (key !== boughKey) {
      boughKey = key;
      // The person's own ornament is first.
      const order = [...state.people].sort((a, b) => Number(b.id === me) - Number(a.id === me));
      const cells = order.map((p, i) => {
        const h = hash(p.id);
        return `
          <button class="orn shape-${h % 3}" type="button" role="tab" data-person="${p.id}"
            style="--drop:${10 + (h % 5) * 5}px;--d:${-((h % 7) * 0.7).toFixed(1)}s;--i:${i}">
            ${segment(String(h % 4))}
            <span class="hang">
              <span class="thread"></span>
              <span class="ball">${esc(p.name.trim().charAt(0).toUpperCase())}</span>
              <span class="who"></span>
            </span>
          </button>`;
      });
      boughEl.innerHTML = `
        <span class="orn end" aria-hidden="true">${segment('base')}</span>
        ${cells.join('')}
        <button class="orn add" type="button" data-person="+" style="--drop:16px;--d:-1.3s;--i:${order.length}" aria-label="Add a person">
          ${segment('2')}
          <span class="hang"><span class="thread"></span><span class="ball">+</span><span class="who add-label">Add</span></span>
        </button>
        <span class="orn end" aria-hidden="true">${segment('tip')}</span>`;
    }
    const current = picking ? '' : list;
    boughEl.querySelector('.add-label')!.textContent = picking ? 'I am new' : 'Add';
    boughEl.querySelectorAll<HTMLElement>('.orn[data-person]').forEach((el) => {
      const id = el.dataset.person!;
      if (id === '+') return;
      const on = id === current;
      el.classList.toggle('on', on);
      el.classList.toggle('me', id === me && !picking);
      el.setAttribute('aria-selected', String(on));
      const p = person(id)!;
      el.querySelector('.who')!.textContent = id === me && !picking ? 'You' : p.name;
      el.setAttribute('aria-label', picking ? `I am ${p.name}` : id === me ? 'My list' : `${possessive(p.name)} list`);
    });
    const onEl = boughEl.querySelector<HTMLElement>('.orn.on');
    if (onEl) {
      // Bring the selected ornament into view (only when it is near an edge or out of view).
      const a = onEl.getBoundingClientRect();
      const b = boughWrap.getBoundingClientRect();
      const pad = 40;
      if (a.left < b.left + pad || a.right > b.right - pad) {
        const left = boughWrap.scrollLeft + (a.left + a.width / 2) - (b.left + b.width / 2);
        boughWrap.scrollTo({ left, behavior: 'smooth' });
      }
    } else {
      boughWrap.scrollTo({ left: 0, behavior: 'smooth' });
    }
  }

  // ---------- pieces of the list ----------
  const lab = (text: string, optional = false) => `<span class="lab">${text}${optional ? '<em>optional</em>' : ''}</span>`;

  /** The form for a new gift or a changed gift. One field is needed; the others are optional and open from chips. */
  function giftForm(g?: Gift, ownerName = '') {
    const own = list === me;
    const key = g ? g.id : 'add';
    const heading = g ? 'Change this gift' : own ? 'Add a gift to my list' : `Add a surprise for ${esc(ownerName)}`;
    const help = g ? '' : own
      ? 'Type what you would like, or paste a link from a shop.'
      : `Something ${esc(ownerName)} did not ask for. ${esc(ownerName)} will not see it.`;
    const submit = g ? 'Save' : own ? 'Add to my list' : 'Add the surprise';
    const shown = { link: !!g?.link || (!g && !!draftPreview), size: !!g?.size, note: !!g?.note };
    const pv = g ? (g.link ? card(g.link, g.preview) : '') : draftPreview ? card(draftPreview.url, draftPreview.data) : '';
    // Quick sizes: the sizes of the person the gift is for.
    const quick = SIZES.filter(([k]) => k !== 'other' && person(list)?.sizes?.[k])
      .map(([k, label]) => `<button class="size-tag pick" type="button" data-act="fill-size" data-v="${esc(person(list)!.sizes![k])}" title="${label}">${sizeIcon(k)}${esc(person(list)!.sizes![k])}</button>`)
      .join('');
    const box = (name: 'link' | 'size' | 'note', body: string) =>
      `<div class="opt" data-opt="${name}" data-keep="opt-${name}-${key}" ${shown[name] ? '' : 'hidden'}>${body}</div>`;
    const chip = (name: string, label: string, icon: string) =>
      `<button class="chip" type="button" data-act="opt" data-opt="${name}">${icon}${label}</button>`;
    return `
      <form class="gift-form composer${g ? ' editing' : ''}" data-form="${g ? 'edit' : 'add'}" ${g ? `data-id="${g.id}"` : ''}>
        <p class="composer-title">${heading}</p>
        <label class="field">
          ${lab('Gift')}
          <input name="title" maxlength="1000" placeholder="${own ? 'For example: wool socks' : 'For example: a book'}" value="${esc(g?.title ?? '')}" autocomplete="off" enterkeyhint="done" />
        </label>
        ${help ? `<p class="help">${help}</p>` : ''}
        ${box('link', `
          <label class="field">${lab('Link', true)}<input name="link" type="text" inputmode="url" autocapitalize="off" spellcheck="false" maxlength="1000" placeholder="Paste the address of the page" value="${esc(g?.link ?? '')}" /></label>
          <div class="form-preview">${pv}</div>`)}
        ${box('size', `
          <label class="field">${lab('Size', true)}<input name="size" maxlength="40" placeholder="For example: M" value="${esc(g?.size ?? '')}" autocomplete="off" /></label>
          ${quick ? `<p class="quick"><span>Tap to fill:</span>${quick}</p>` : ''}`)}
        ${box('note', `
          <label class="field">${lab('Note', true)}<textarea name="note" maxlength="600" rows="2" placeholder="Color, where to buy, and so on">${esc(g?.note ?? '')}</textarea></label>`)}
        <p class="chips"><span class="lab">Add if you want</span>${chip('link', 'Link', ICON.link)}${chip('size', 'Size', ICON.top)}${chip('note', 'Note', ICON.note)}</p>
        <div class="composer-end">
          <button class="primary" type="submit">${submit}${ICON.arrow}</button>
          ${g ? `<button class="quiet" type="button" data-act="cancel-edit">Cancel</button>` : ''}
        </div>
      </form>`;
  }

  function commentsHtml(comments: Comment[], gift: string | undefined, placeholder: string, form = true) {
    const items = comments
      .map(
        (c) => `<li class="comment${seen.has(c.id) ? '' : ' fresh'}">
          <span class="face">${esc(initial(c.by))}</span>
          <span class="comment-body"><strong>${esc(c.by === me ? 'You' : nameOf(c.by))}</strong> ${esc(c.text)}
          ${c.by === me ? `<button class="quiet" type="button" data-act="del-comment" data-id="${c.id}">${confirming === c.id ? 'Tap again to remove' : 'Remove'}</button>` : ''}</span>
        </li>`,
      )
      .join('');
    return `
      ${items ? `<ul class="comments">${items}</ul>` : ''}
      ${form ? `<form class="note-field" data-form="comment" ${gift ? 'data-gift="' + gift + '"' : ''}>
        <label class="field">
          ${lab('Note', true)}
          <input name="text" maxlength="600" placeholder="${esc(placeholder)}" autocomplete="off" enterkeyhint="send" />
        </label>
        <button class="post" type="submit">Post${ICON.arrow}</button>
      </form>` : ''}`;
  }

  /** The line under a gift title that says who got it or who pairs up. */
  function statusOf(g: Gift) {
    const team = g.team ?? [];
    if (g.gotBy) {
      const who = team.length > 1 && team.includes(g.gotBy) ? team : [g.gotBy];
      return { kind: 'got', who, text: `${names(who)} got this` };
    }
    if (team.length === 1) {
      return { kind: 'pair', who: team, text: team[0] === me ? 'You want to tag team' : `${nameOf(team[0])} wants to tag team` };
    }
    if (team.length > 1) return { kind: 'pair', who: team, text: `${names(team)} tag team on this` };
    return { kind: '', who: [] as string[], text: '' };
  }

  function act(action: string, id: string, icon: string, label: string, extra = '') {
    return `<button class="act act-${action}" type="button" data-act="${action}" data-id="${id}" ${extra}>${icon}<span>${esc(label)}</span></button>`;
  }

  /** Under each gift: the actions, in view at all times. No tap to open. */
  function rowEnd(g: Gift, view: View) {
    const mine = g.addedBy === me;
    const tools = mine
      ? `<button class="quiet" type="button" data-act="edit" data-id="${g.id}">Change</button>
         <button class="quiet" type="button" data-act="del-gift" data-id="${g.id}">${confirming === g.id ? 'Tap again to remove' : 'Remove'}</button>`
      : '';
    if (view.own) return tools ? `<div class="row-acts">${tools}</div>` : '';

    const team = g.team ?? [];
    const inTeam = team.includes(me);
    let acts = '';
    if (g.gotBy) {
      if (g.gotBy === me || inTeam) acts = act('got', g.id, ICON.undo, 'Not got after all');
    } else if (team.length && !inTeam) {
      acts = act('pair', g.id, ICON.rings, `Join ${names(team)}`, 'data-on="1"');
    } else if (inTeam) {
      acts =
        act('got', g.id, ICON.bow, team.length > 1 ? 'We got it' : 'I got it', 'data-got="1"') +
        act('pair', g.id, ICON.undo, team.length > 1 ? 'Leave the team' : 'Stop looking');
    } else {
      acts = act('got', g.id, ICON.bow, 'I got it', 'data-got="1"') + act('pair', g.id, ICON.rings, 'Tag team', 'data-on="1"');
    }
    const comments = view.comments.filter((c) => c.gift === g.id);
    const writing = open.has(g.id);
    const noteChip = writing ? '' : `<button class="chip" type="button" data-act="toggle" data-id="${g.id}">${ICON.note}Note</button>`;
    const notes = comments.length || writing ? `<div class="row-notes">${commentsHtml(comments, g.id, 'Write to the others', writing)}</div>` : '';
    return `<div class="row-acts">${acts}${noteChip}${tools}</div>${notes}`;
  }

  function giftRow(g: Gift, view: View, ownerName: string) {
    if (editing === g.id) return `<li class="gift">${giftForm(g)}</li>`;
    const st = view.own ? { kind: '', who: [] as string[], text: '' } : statusOf(g);
    const pop = st.kind === 'got' && gotBefore.has(g.id) && !gotBefore.get(g.id);
    const faces = st.who.length
      ? `<span class="faces">${st.who.map((id) => `<span class="face">${esc(initial(id))}</span>`).join('')}${st.kind === 'pair' && st.who.length === 1 ? '<span class="face seat">+</span>' : ''}</span>`
      : '';
    const meta = [
      g.size ? `<span class="size-tag">Size ${esc(g.size)}</span>` : '',
      st.text ? `<span class="status">${esc(st.text)}</span>` : '',
      g.idea ? `<span>Surprise from ${esc(g.addedBy === me ? 'you' : nameOf(g.addedBy))}</span>` : '',
    ].filter(Boolean).join('');
    return `
      <li class="gift${st.kind ? ` is-${st.kind}` : ''}${seen.has(g.id) ? '' : ' fresh'}${pop ? ' pop' : ''}">
        <div class="gift-head">
          <span class="mark">${view.own ? ICON.spark : parcel(g.id)}</span>
          <span class="gift-body">
            <span class="gift-title">${esc(g.title)}</span>
            ${g.note ? `<span class="gift-note">${esc(g.note)}</span>` : ''}
            ${meta ? `<span class="gift-meta">${meta}</span>` : ''}
          </span>
          ${faces}
        </div>
        ${g.link ? card(g.link, g.preview) : ''}
        ${rowEnd(g, view)}
      </li>`;
  }

  /** A chip shows only while its optional field is closed. */
  function syncChips(form: HTMLFormElement) {
    let left = 0;
    form.querySelectorAll<HTMLElement>('.chip').forEach((chip) => {
      const box = form.querySelector<HTMLElement>(`.opt[data-opt="${chip.dataset.opt}"]`)!;
      chip.hidden = !box.hidden;
      if (box.hidden) left++;
    });
    form.querySelector<HTMLElement>('.chips')!.hidden = left === 0;
  }
  function openOpt(form: HTMLFormElement, name: string, focus = false) {
    const box = form.querySelector<HTMLElement>(`.opt[data-opt="${name}"]`)!;
    box.hidden = false;
    syncChips(form);
    if (focus) box.querySelector<HTMLElement>('input, textarea')?.focus();
  }

  // ---------- draw the page ----------
  function render() {
    // Keep a person who no longer exists out of the page.
    if (me && !person(me)) { me = ''; picking = true; }
    if (list && !person(list)) list = '';
    if (!me) picking = true;
    renderBough();

    const url = new URL(location.href);
    if (list && !picking) url.searchParams.set('list', list);
    else url.searchParams.delete('list');
    history.replaceState(null, '', url);

    $('person-submit').textContent = picking || !state.people.length ? 'This is me' : 'Add this person';
    whoEl.hidden = picking;
    if (!picking) whoEl.innerHTML = `You are ${esc(nameOf(me))}. <button class="quiet" type="button" id="not-me">Not you?</button>`;

    // Keep what the person types (and the cursor) when the list draws again.
    const keyOf = (el: HTMLInputElement) => {
      const fm = el.form;
      return fm ? `${fm.dataset.form}|${fm.dataset.gift ?? fm.dataset.id ?? ''}|${el.name}` : '';
    };
    const drafts = new Map<string, string>();
    viewEl.querySelectorAll<HTMLInputElement>('form input, form textarea').forEach((el) => {
      if (el.value) drafts.set(keyOf(el), el.value);
    });
    const focused = document.activeElement as HTMLInputElement | null;
    const focusKey = focused && viewEl.contains(focused) && focused.name ? keyOf(focused) : '';
    const keep = new Map<string, boolean>();
    viewEl.querySelectorAll<HTMLElement>('[data-keep]').forEach((d) => keep.set(d.dataset.keep!, d instanceof HTMLDetailsElement ? d.open : !d.hidden));

    viewEl.innerHTML = viewHtml();

    viewEl.querySelectorAll<HTMLElement>('[data-keep]').forEach((d) => {
      if (!keep.has(d.dataset.keep!)) return;
      if (d instanceof HTMLDetailsElement) d.open = keep.get(d.dataset.keep!)!;
      else d.hidden = !keep.get(d.dataset.keep!);
    });
    viewEl.querySelectorAll<HTMLFormElement>('form.gift-form').forEach(syncChips);
    viewEl.querySelectorAll<HTMLInputElement>('form input, form textarea').forEach((el) => {
      const k = keyOf(el);
      if (drafts.has(k)) el.value = drafts.get(k)!;
      if (k === focusKey) el.focus({ preventScroll: true });
    });
    const view = state.view;
    if (view && !picking) {
      seen = new Set([...view.gifts.map((g) => g.id), ...view.comments.map((c) => c.id)]);
      gotBefore = new Map(view.gifts.map((g) => [g.id, g.gotBy ?? '']));
    }
  }

  /** At the end of a list: remove the person. A second tap is necessary. */
  function removeHtml(p: Person) {
    const own = p.id === me;
    const ask = own ? 'Remove me and my list' : `Remove ${esc(p.name)} and this list`;
    const sure = own
      ? 'Tap again to remove you, your list, and all that you added. You cannot get them back.'
      : `Tap again to remove ${esc(p.name)}, this list, and all that ${esc(p.name)} added. You cannot get them back.`;
    const on = confirming === p.id;
    return `<p class="tools end"><button class="quiet${on ? ' danger' : ''}" type="button" data-act="del-person" data-id="${p.id}">${on ? sure : ask}</button></p>`;
  }

  function viewHtml() {
    $('xmas').classList.toggle('is-empty', !state.people.length);
    $('xmas').classList.toggle('is-picking', picking && state.people.length > 0);
    if (!state.people.length) {
      addPersonForm.hidden = false;
      return `<p class="step">First step</p><h1>Who are you?</h1><p class="hint">Write your name to hang the first ornament.</p>`;
    }
    if (picking) {
      return `
        <p class="step">First step</p>
        <h1>Who are you?</h1>
        <p class="hint">Tap the ornament with your name. Then you can write your list and see the lists of the others.</p>
        <p class="point">${ICON.down}<span>Tap your name</span></p>`;
    }
    const owner = person(list);
    const view = state.view;
    if (!owner) return `<h1>Whose list?</h1><p class="hint">Tap an ornament to open a list.</p>`;
    if (!view) return `<h1>${owner.id === me ? 'My list' : `${esc(possessive(owner.name))} list`}</h1><p class="hint">Opening the list…</p>`;

    const ownerName = owner.name;
    const asked = view.gifts.filter((g) => !g.idea);
    const ideas = view.gifts.filter((g) => g.idea);
    const listNotes = view.comments.filter((c) => !c.gift);
    const rows = (gifts: Gift[]) => `<ul class="gifts">${gifts.map((g) => giftRow(g, view, ownerName)).join('')}</ul>`;

    if (view.own) {
      return `
        <h1>My list</h1>
        <p class="lede">The others see this list and plan in secret. You never see who got what.</p>
        ${sizesHtml(owner, true)}
        ${giftForm(undefined, ownerName)}
        ${asked.length ? rows(asked) : `<p class="empty">${ICON.spark}<span>Your list is empty. Add your first gift in the box above.</span></p>`}
        ${removeHtml(owner)}`;
    }

    const got = view.gifts.filter((g) => g.gotBy).length;
    const pairs = view.gifts.filter((g) => !g.gotBy && g.team?.length).length;
    const tally = [got ? `${got} of ${view.gifts.length} got` : '', pairs ? `${pairs} to tag team on` : ''].filter(Boolean).join(', ');
    return `
      <h1>${esc(possessive(ownerName))} list</h1>
      <p class="lede">${esc(ownerName)} sees nothing of what you do here.${tally ? ` <strong>${tally}.</strong>` : ''}</p>
      ${view.gifts.length ? `<p class="legend">
        <span>${svg(PARCELS[0] + BOW, '0 0 40 40')}Free</span>
        <span class="is-pair">${svg(PARCELS[0] + BOW, '0 0 40 40')}Tag team</span>
        <span class="is-got">${svg(PARCELS[0] + BOW, '0 0 40 40')}Got</span>
      </p>
      <p class="help center guide">“I got it” tells the others that you have the gift. “Tag team” asks for a partner to buy it together.</p>` : ''}
      ${sizesHtml(owner, false)}
      <section class="group">
        <h2 class="label">${esc(ownerName)} asked for</h2>
        ${asked.length ? rows(asked) : `<p class="empty">${ICON.spark}<span>${esc(ownerName)} has not asked for anything yet.</span></p>`}
      </section>
      <section class="group">
        <h2 class="label">Surprises <small>ideas from the others</small></h2>
        ${ideas.length ? rows(ideas) : ''}
        ${giftForm(undefined, ownerName)}
      </section>
      <section class="group">
        <h2 class="label">Notes for the others <small>${esc(ownerName)} cannot see them</small></h2>
        ${commentsHtml(listNotes, undefined, 'Write to the others')}
      </section>
      ${removeHtml(owner)}`;
  }

  // ---------- actions ----------
  function reset() {
    open.clear();
    editing = confirming = '';
    seen = new Set();
    gotBefore = new Map();
    draftPreview = null;
  }

  function pick(id: string) {
    if (picking) {
      me = id;
      store.set('xmas-me', me);
      picking = false;
      boughKey = ''; // put "You" first
      if (!list || !person(list)) list = me;
    } else {
      list = id;
    }
    store.set('xmas-list', list);
    reset();
    addPersonForm.hidden = true;
    state.view = null;
    lastData = '';
    render(); // show the choice immediately, then get the list
    call();
  }

  boughEl.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.orn[data-person]');
    if (!el) return;
    if (el.dataset.person === '+') {
      addPersonForm.hidden = false;
      personInput.focus();
      return;
    }
    pick(el.dataset.person!);
  });

  whoEl.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).id !== 'not-me') return;
    picking = true;
    boughKey = '';
    reset();
    render();
  });

  addPersonForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!personInput.value.trim()) return personInput.focus();
    const data = await call({ action: 'addPerson', name: personInput.value });
    if (!data?.person) return;
    personInput.value = '';
    addPersonForm.hidden = true;
    pick(data.person.id);
  });
  addPersonForm.querySelector('[data-cancel]')!.addEventListener('click', () => { addPersonForm.hidden = true; });

  viewEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const fields = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const kind = form.dataset.form;
    const gift = form.dataset.gift ?? '';
    if (kind === 'sizes') return void saveSizes(form);
    if ((kind === 'add' || kind === 'edit') && !fields.title?.trim() && !fields.link?.trim()) {
      // Nothing to save: show where to type.
      return (form.elements.namedItem('title') as HTMLInputElement).focus();
    }
    if (kind === 'comment' && !fields.text?.trim()) return;
    // Empty the fields now, so the next gift can be typed while this one saves.
    if (kind !== 'edit') form.reset();
    if (kind === 'add') {
      form.querySelectorAll<HTMLElement>('.opt').forEach((b) => { b.hidden = true; });
      syncChips(form);
      draftPreview = null;
      form.querySelector('.form-preview')!.innerHTML = '';
    }
    let ok = null;
    if (kind === 'add') ok = await call({ action: 'addGift', ...fields });
    if (kind === 'edit') ok = await call({ action: 'editGift', id: form.dataset.id, ...fields });
    if (kind === 'comment') ok = await call({ action: 'comment', gift, ...fields });
    if (ok && kind === 'edit') { editing = ''; render(); }
    if (!ok && kind !== 'edit') {
      // It did not save: give the text back.
      const sel = kind === 'add' ? 'form[data-form="add"]' : `form[data-form="comment"]${gift ? `[data-gift="${gift}"]` : ':not([data-gift])'}`;
      const again = viewEl.querySelector<HTMLFormElement>(sel);
      if (again) for (const [k, v] of Object.entries(fields)) {
        const el = again.elements.namedItem(k) as HTMLInputElement | null;
        if (el && !el.value) el.value = v;
      }
    }
  });

  viewEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
    if (!btn) return;
    const id = btn.dataset.id ?? '';
    const action = btn.dataset.act;
    if (action === 'opt') return openOpt(btn.closest('form')!, btn.dataset.opt!, true);
    if (action === 'fill-size') {
      const input = btn.closest('form')!.elements.namedItem('size') as HTMLInputElement;
      input.value = btn.dataset.v ?? '';
      return;
    }
    if (action === 'toggle') {
      // Open the line for a note about this gift.
      open.add(id);
      render();
      viewEl.querySelector<HTMLInputElement>(`form[data-form="comment"][data-gift="${id}"] [name="text"]`)?.focus();
      return;
    }
    if (action === 'got') { btn.classList.add('wait'); return void call({ action: 'got', id, got: !!btn.dataset.got }); }
    if (action === 'pair') { btn.classList.add('wait'); return void call({ action: 'pair', id, on: !!btn.dataset.on }); }
    if (action === 'edit') { editing = id; render(); (viewEl.querySelector('.editing [name="title"]') as HTMLInputElement)?.focus(); return; }
    if (action === 'cancel-edit') { editing = ''; render(); return; }
    if (action === 'del-gift' || action === 'del-comment' || action === 'del-person') {
      if (confirming !== id) {
        confirming = id;
        render();
        setTimeout(() => { if (confirming === id) { confirming = ''; render(); } }, action === 'del-person' ? 7000 : 4000);
        return;
      }
      confirming = '';
      if (action === 'del-person') {
        return void call({ action: 'removePerson', id }).then((ok) => {
          if (!ok) return;
          if (id === me) { me = ''; store.set('xmas-me', ''); picking = true; boughKey = ''; }
          list = me;
          store.set('xmas-list', list);
          reset();
          render();
          call();
        });
      }
      return void call({ action: action === 'del-gift' ? 'deleteGift' : 'deleteComment', id });
    }
  });

  // Sizes save when a field changes. No button.
  let sizesSent = '';
  function saveSizes(form: HTMLFormElement) {
    const sizes = Object.fromEntries(new FormData(form)) as Sizes;
    const key = JSON.stringify(sizes);
    if (key === sizesSent) return;
    sizesSent = key;
    call({ action: 'sizes', sizes }).then((ok) => {
      const el = document.getElementById('sizes-saved');
      if (!ok || !el) return;
      el.textContent = 'Saved.';
      setTimeout(() => { el.textContent = ''; }, 2500);
    });
  }
  viewEl.addEventListener('change', (e) => {
    const form = (e.target as HTMLInputElement).form;
    if (form?.dataset.form === 'sizes') saveSizes(form);
  });

  // A pasted link shows its preview (picture, name, shop), as in a message app.
  let previewFor = '';
  let previewTimer = 0;
  async function loadPreview(kind: string, url: string) {
    const find = () => viewEl.querySelector<HTMLFormElement>(`form[data-form="${kind}"]`);
    previewFor = url;
    const slot = find()?.querySelector('.form-preview');
    if (slot) slot.innerHTML = '<p class="say">Reading the link…</p>';
    let data: Preview | null = null;
    try {
      const res = await fetch('/api/xmas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'preview', me, url }),
      });
      if (res.ok) data = (await res.json()).preview ?? null;
    } catch { /* no preview */ }
    const form = find();
    if (previewFor !== url || !form) return;
    const link = form.elements.namedItem('link') as HTMLInputElement;
    if (link.value.trim() !== url) return;
    if (kind === 'add') draftPreview = { url, data };
    form.querySelector('.form-preview')!.innerHTML = card(/^https?:/i.test(url) ? url : `https://${url}`, data);
    const title = form.elements.namedItem('title') as HTMLInputElement;
    if (!title.value.trim() && data?.title) title.value = data.title.slice(0, 140);
    if (!title.value.trim()) title.placeholder = 'Name of the gift';
  }
  viewEl.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    const form = el.form;
    const kind = form?.dataset.form;
    if (!form || (kind !== 'add' && kind !== 'edit')) return;
    const link = form.elements.namedItem('link') as HTMLInputElement;
    if (el.name === 'title' && looksLikeLink(el.value)) {
      // A link in the line for the gift: move it to the link line and read it.
      link.value = el.value.trim();
      el.value = '';
      openOpt(form, 'link');
      loadPreview(kind, link.value);
    } else if (el.name === 'link') {
      clearTimeout(previewTimer);
      const url = el.value.trim();
      if (!url) {
        if (kind === 'add') draftPreview = null;
        form.querySelector('.form-preview')!.innerHTML = '';
      } else if (/^(https?:\/\/)?[^\s.]+\.\S{2,}$/i.test(url)) {
        previewTimer = window.setTimeout(() => loadPreview(kind, url), 600);
      }
    }
  });
  // A picture that does not load is removed from its card.
  viewEl.addEventListener('error', (e) => {
    const img = e.target as HTMLElement;
    if (img.tagName === 'IMG' && img.closest('.pv')) {
      img.closest('.pv')!.classList.add('no-img');
      img.parentElement!.remove();
    }
  }, true);

  // Get the changes that others make: when the tab comes back, and every 20 seconds.
  const refresh = () => {
    if (document.visibilityState === 'visible' && !busy && !editing && !confirming) queue = queue.then(() => send(undefined, true)).catch(() => null);
  };
  document.addEventListener('visibilitychange', refresh);
  setInterval(refresh, 20000);

  call();
</script>

<style is:global>
  .xmas { max-width: 600px; display: flex; flex-direction: column; }
  /* The first visit: the question is above the line for the name. */
  .xmas.is-empty .add-person { order: 1; margin-top: 4px; }
  .xmas.is-empty .add-person .quiet { display: none; }
  .xmas.is-empty .hint { margin-bottom: 8px; }
  .xmas h1 { font-size: clamp(2.6rem, 11vw, 4rem); text-align: center; margin: 0 0 14px; }
  .xmas .top { text-align: center; margin: 0; }
  .xmas .whoami { text-align: center; margin: 2px 0 0; font-size: 0.85rem; color: var(--muted); }
  .xmas .hint, .xmas .lede { text-align: center; color: var(--muted); margin: 0 auto 28px; max-width: 34em; font-size: 0.95rem; }
  .xmas .lede strong { color: var(--accent); font-weight: 600; white-space: nowrap; }

  /* Quiet text controls: no boxes. */
  .xmas .quiet {
    font: inherit;
    font-size: 0.82rem;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 6px 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 4px;
  }
  .xmas .quiet:hover { color: var(--accent); text-decoration-color: var(--accent); }

  /* ---------- The branch with one ornament for each person ---------- */
  .xmas .bough-wrap {
    overflow-x: auto;
    overflow-y: hidden;
    /* Full width of the screen, so a large family fits on a computer. */
    margin: 18px calc(50% - 50vw + 9px) 6px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* The branch fades at the two edges of the screen. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 28px, #000 calc(100% - 28px), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 28px, #000 calc(100% - 28px), transparent);
  }
  .xmas .bough-wrap::-webkit-scrollbar { display: none; }
  .xmas .bough { display: flex; width: max-content; margin: 0 auto; padding: 0 20px; }
  .xmas .orn {
    position: relative;
    flex: none;
    width: 84px;
    height: 142px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .xmas .orn.end { width: 46px; cursor: default; }
  .xmas .orn.end:first-child .seg { left: auto; right: 0; }
  .xmas .seg { position: absolute; top: 0; left: 0; width: 84px; height: 34px; overflow: visible; fill: none; stroke-linecap: round; }
