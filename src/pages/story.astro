---
import Layout from '../layouts/Layout.astro';
import { story } from '../data/wedding';
---

<Layout title="Our Story">
  <div class="container">
    <div class="page-title">
      <p class="eyebrow">Our Story</p>
      <h1>How we got here</h1>
    </div>
    <ol class="timeline">
      {
        story.map((item) => (
          <li class="card">
            <p class="eyebrow">{item.date}</p>
            <h3>{item.title}</h3>
            {item.text && <p>{item.text}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</Layout>

<style>
  .timeline { list-style: none; padding: 0 0 0 28px; margin: 0; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 1px; background: var(--accent); }
  .timeline li { position: relative; }
  .timeline li::before {
    content: ''; position: absolute; left: -28px; top: 34px; width: 15px; height: 15px;
    border-radius: 50%; background: var(--bg); border: 2px solid var(--accent);
  }
  .timeline h3 { margin-bottom: 0; }
  .timeline p:last-child { margin-bottom: 0; }
  .timeline .eyebrow { margin: 0 0 6px; }
</style>
