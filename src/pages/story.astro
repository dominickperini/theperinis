---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { story } from '../data/wedding';
import { storyPhotos } from '../data/media';
---

<Layout title="Our Story">
  <div class="container">
    <div class="page-title">
      <p class="eyebrow">Our Story</p>
      <h1>How we got here</h1>
      <p>Swipe or scroll to the side.</p>
    </div>
  </div>

  <!-- The story as a film strip: one photo and one field note for each milestone. -->
  <div class="strip-wrap">
    <ol class="strip" tabindex="0" aria-label="Our story, oldest first">
      {
        story.map((item, i) => (
          <li class="frame-item reveal" style={`--delay: ${Math.min(i, 4) * 0.08}s`}>
            <Photo
              media={{ ...storyPhotos[i % storyPhotos.length], note: item.date }}
              index={i + 1}
              ratio="4 / 5"
              sizes="(min-width: 900px) 30vw, 78vw"
            />
            <h3>{item.title}</h3>
            {item.text && <p class="serif muted">{item.text}</p>}
          </li>
        ))
      }
    </ol>
    <div class="wide"><hr class="oak-rule shelf" /></div>
  </div>
</Layout>

<style>
  .strip-wrap { position: relative; }
  .strip {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter) 24px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 380px);
    gap: clamp(20px, 3vw, 40px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--text) transparent;
  }
  .shelf { height: 14px; margin-top: 8px; box-shadow: 0 10px 18px -12px rgba(42, 40, 36, 0.5), inset 0 -1px 0 rgba(42, 40, 36, 0.2); }
  .strip:focus-visible { outline-offset: -2px; }
  .frame-item { scroll-snap-align: start; border-top: 1px solid var(--text); padding-top: 14px; }
  .frame-item :global(.photo) { margin-bottom: 18px; }
  .frame-item :global(figcaption) { order: -1; margin: 0 0 12px; }
  .frame-item :global(.photo) { display: flex; flex-direction: column; }
  .frame-item h3 { margin: 0 0 6px; }
  .frame-item p { margin: 0; font-size: 1.05rem; }
  /* Every second frame sits lower, like prints on a table. */
  @media (min-width: 720px) {
    .frame-item:nth-child(even) { margin-top: 64px; }
  }
</style>
