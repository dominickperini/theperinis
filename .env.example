# Upstash Redis (add it in Vercel: Storage > Create > Upstash for Redis).
# Vercel sets these for you when you connect the database to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# A long random secret. You use it to download the RSVP list:
# https://theperinis.net/api/rsvps?key=YOUR_ADMIN_KEY
ADMIN_KEY=
